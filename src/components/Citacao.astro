---

<Faixa
  onda="onda-creme-final"
  cor="var(--roxo)"
  corOnda="var(--creme)"
  id="sobre"
  classe="citacao"
  papel
>
  <!-- Formas que escorrem da onda creme, por cima do roxo. Ficam na
       frente para cobrir as formas do fundo que passam por baixo. -->
  <Enfeites
    lista={FORMAS_DA_ONDA}
    nome="FORMAS_DA_ONDA"
    arquivo="src/components/Citacao.astro"
  />

  <!-- Formas do fundo, tiradas de fundos/citacao.png. -->
  <Enfeites
    lista={ENFEITES}
    nome="ENFEITES"
    arquivo="src/components/Citacao.astro"
  />

  <blockquote class="conteudo frase surge">
    <p>
      {
        LINHAS.map((linha, i) => (
          <span class="linha">
            {i === 0 && "“"}
            {linha}
            {i === LINHAS.length - 1 && "”"}
            {i < LINHAS.length - 1 && " "}
          </span>
        ))
      }
    </p>
  </blockquote>
</Faixa>

<style>
  .faixa {
    position: relative;
    z-index: 1;
  }

  .enfeite {
    position: absolute;
    z-index: 0;
  }

  .conteudo {
    position: relative;
    z-index: 2;
  }

  /* A caixa serve de régua para a fonte (container-type): o tamanho do
     texto sai da largura dela, não da tela. */
  .frase {
    container-type: inline-size;
    text-align: center;
    width: min(200% - 2rem, 1000px);
    color: var(--branco);
    margin: clamp(140px, 18vw, 140px) auto clamp(80px, 16vw, 120px);
  }

  /* No desktop, mantém cada linha inteira e dimensiona a fonte pela
     largura da caixa para a frase acompanhar telas maiores e menores. */
  .frase p {
    font-size: 4.5cqi;
    font-weight: 700;
    font-style: italic;
    line-height: 1.109375;
    letter-spacing: 0.5px;
    max-width: none;
  }

  /* No desktop, uma linha por bloco e sem quebra interna. */
  .linha {
    display: block;
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .frase {
      width: min(calc(100% - 2rem), 482px);
      margin: 3rem auto 2.5rem;
    }

    .frase p {
      font-size: clamp(1rem, 5cqi, 1.6rem);
      line-height: 1.35;
    }

    .linha {
      display: inline;
      white-space: normal;
    }
  }
</style>
