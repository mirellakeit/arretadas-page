    cor: APAGADA,
    opacidade: 0.2,
    tamanho: "15vw",
    topo: "4.8vw",
    esquerda: "54.5%",
    giro: 12,
    noCelular: true,
  },
  {
    forma: "estrela",
    cor: APAGADA,
    opacidade: 0.2,
    tamanho: "2.3vw",
    topo: "5.5vw",
    esquerda: "30.5%",
  },
  {
    forma: "asterisco",
    cor: APAGADA,
    opacidade: 0.2,
    tamanho: "15vw",
    topo: "6.1vw",
    esquerda: "93.9%",
  },
  {
    forma: "estrela-arredondada",
    cor: APAGADA,
    opacidade: 0.2,
    tamanho: "6.6vw",
    topo: "8.5vw",
    esquerda: "36.4%",
    giro: 8,
    papel: true,
    noCelular: true,
    tamanhoMobile: "11vw",
    topoMobile: "22%",
  },
  {
    forma: "trevo",
    cor: APAGADA,
    opacidade: 0.2,
    tamanho: "6.6vw",
    topo: "8.9vw",
    esquerda: "75.6%",
    noCelular: true,
  },
  {
    forma: "estrela",
    cor: APAGADA,
    opacidade: 0.2,
    tamanho: "5vw",
    topo: "10.5vw",
    esquerda: "22%",
    noCelular: true,
    tamanhoMobile: "8vw",
    topoMobile: "26%",
  },
  {
    forma: "estrela",
    cor: APAGADA,
    opacidade: 0.2,
    tamanho: "2.25vw",
    topo: "14.4vw",
    esquerda: "91.2%",
  },
  {
    forma: "estrela",
    cor: APAGADA,
    opacidade: 0.2,
    tamanho: "2.25vw",
    topo: "16.7vw",
    esquerda: "47.7%",
  },

  // base: ancoradas por baixo, para não depender da altura da faixa.
  // Ficam inteiras dentro dela, senão o fim da faixa corta a forma.
  {
    forma: "trevo",
