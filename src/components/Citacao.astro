---
// =========================================================================
// SEÇÃO DE CITAÇÃO
// Faixa roxa com a onda creme escorrendo do Hero para dentro dela.
// =========================================================================

import Faixa from "./Faixa.astro";
import Enfeites from "./Enfeites.astro";
import { ENFEITES_CITACAO } from "../data/enfeites.js";

// Cada item é uma linha. A quebra é sempre esta, no desktop e no
// celular: a fonte encolhe com a largura para a linha mais longa caber.
const LINHAS = [
  "Serei dona do espaço que deve ser meu.",
  "Inteira, indomável, e não passageira, na rua,",
  "nas redes, no balanço de saber quem sou eu.",
];
---

<Faixa
  onda="onda-creme-final"
  cor="var(--roxo)"
  corOnda="var(--creme)"
  id="sobre"
  classe="citacao"
  papel
  forcaPapel={0.15}
>
  <Enfeites lista={ENFEITES_CITACAO} />

  <blockquote class="conteudo frase surge">
    <p>
      {LINHAS.map((linha, i) => (
        <span class="linha">
          {i === 0 && "“"}
          {linha}
          {i === LINHAS.length - 1 && "”"}
        </span>
      ))}
    </p>
  </blockquote>
</Faixa>

<style>
  /* A caixa serve de régua para a fonte (container-type): o tamanho do
     texto sai da largura dela, não da tela. */
  .frase {
    container-type: inline-size;
    text-align: center;
    width: min(200% - 2rem, 1000px);
    color: var(--branco);
    margin: clamp(140px, 18vw, 200px) auto clamp(80px, 16vw, 120px);
  }

  /* A linha mais longa mede 21,2 vezes o tamanho da fonte. Com a fonte
     em 1/22 da caixa (4.5cqi), ela ocupa quase toda a largura e ainda
     sobra folga. Para esticar ou encolher a frase, mude o 1000px da
     largura da caixa acima; a fonte acompanha sozinha. */
  .frase p {
    font-size: 4.5cqi;
    font-weight: 700;
    font-style: italic;
    line-height: 1.109375;
    letter-spacing: 0.5px;
    max-width: none;
  }

  /* Uma linha por bloco, sem quebra dentro dela. */
  .linha {
    display: block;
    white-space: nowrap;
  }
</style>
