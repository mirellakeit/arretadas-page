---
import Faixa from "./Faixa.astro";
import Enfeite from "./Enfeite.astro";

// Enfeites tirados de fundos/sobre-curso.png (layout de 1920px):
// tamanho e topo em vw, esquerda em % da faixa. As formas grandes e
// apagadas usam o roxo claro em opacidade baixa sobre o lilás.
const APAGADA = "#B9A3DC";

const ENFEITES = [
  // Brancas penduradas na onda que vem do "Quem já fez o curso?".
  { forma: "trevo-cinco-lados", cor: "#F5F9FA", tamanho: "12.6vw", topo: "-1.1vw", esquerda: "7.4%", noCelular: true, tamanhoMobile: "18vw" },
  { forma: "asterisco", cor: "#F5F9FA", tamanho: "12.6vw", topo: "-3.9vw", esquerda: "73.8%", giro: 15 },

  // Grandes e apagadas, no fundo. Cabem inteiras na faixa: o fim dela
  // cortaria a forma numa linha reta.
  { forma: "asterisco", cor: APAGADA, opacidade: 0.3, tamanho: "30vw", topo: "-4vw", esquerda: "31%" },
  { forma: "estrela-arredondada", cor: APAGADA, opacidade: 0.35, tamanho: "25.8vw", topo: "23.9vw", esquerda: "82.8%", giro: 8 },
  { forma: "asterisco", cor: APAGADA, opacidade: 0.3, tamanho: "32vw", topo: "22vw", esquerda: "-17%", giro: -10 },
  { forma: "trevo-cinco-lados", cor: APAGADA, opacidade: 0.3, tamanho: "22vw", baixo: "0.5vw", esquerda: "31%" },

  // Destaques em roxo claro e branco.
  { forma: "estrela", cor: "var(--roxo-claro)", tamanho: "3.1vw", topo: "6.8vw", esquerda: "66.1%" },
  { forma: "trevo", cor: "var(--roxo-claro)", tamanho: "12.7vw", topo: "7.9vw", esquerda: "93.5%", noCelular: true, tamanhoMobile: "18vw" },
  { forma: "estrela-arredondada", cor: "#F5F9FA", tamanho: "8.4vw", topo: "9.9vw", esquerda: "67.7%", giro: 12, noCelular: true, tamanhoMobile: "13vw" },
  { forma: "estrela", cor: "var(--roxo-claro)", opacidade: 0.52, tamanho: "4vw", topo: "10.8vw", esquerda: "15.4%" },
  { forma: "estrela-arredondada", cor: "var(--roxo-claro)", tamanho: "9.8vw", topo: "13.5vw", esquerda: "3%", noCelular: true, tamanhoMobile: "15vw" },
  { forma: "trevo", cor: "var(--roxo-claro)", opacidade: 0.87, tamanho: "5.5vw", topo: "13.5vw", esquerda: "22.9%" },
  { forma: "estrela", cor: "var(--roxo-claro)", opacidade: 0.66, tamanho: "4.3vw", topo: "16.4vw", esquerda: "90%" },
];

const MODULOS = [
  {
    texto:
      "Feminismos e Direitos das Mulheres",
    cor: "#ffc5b3",
  },
  {
    texto:
      "Violência Política de Gênero e raça",
    cor: "var(--roxo-claro)",
  },
  {
    texto:
      "Misoginia Digital Interseccional",
    cor: "#f0dae2",
  },
  {
    texto: "Comunicação feminista",
    cor: "#f4d3bc",
  },
  {
    texto:
      "Autodefesa Digital Feminista",
    cor: "#e6abb2",
  },
];
---

<Faixa
  onda="onda-branca"
  id="modulos"
  cor="var(--lilas)"
  corOnda="var(--branco)"
  papel
>
  {ENFEITES.map((e) => <Enfeite {...e} />)}

  <div class="conteudo">
    <header class="titulo surge">
      <span class="sobre">Sobre o</span>
      <h2>Curso</h2>
      <p class="subtitulo">
        O curso é dividido em 5 módulos
      </p>
    </header>

    <ul class="modulos">
      {
        MODULOS.map((item, i) => (
          <li
            tabindex="0"
            class="surge"
            style={`--cor-modulo: ${item.cor}; --atraso: ${i * 110}ms`}
          >
            {item.texto}
          </li>
        ))
      }
    </ul>
  </div>
</Faixa>

<style>
  .conteudo {
    margin-bottom: -5rem;
  }

  .titulo {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    color: #4a3060;
    margin-top: var(--esp-5);
  }

  .sobre {
    font-size: clamp(
      1.25rem,
      2.2vw,
      1.6rem
    );
    font-weight: 800;
    line-height: 1;
  }

  h2 {
    font-size: clamp(3rem, 7vw, 4.4rem);
    line-height: 1;
    font-weight: 900;
  }

  .subtitulo {
    margin-top: var(--esp-1);
    font-size: clamp(
      1.1rem,
      2vw,
      1.5rem
    );
    font-weight: 800;
    line-height: 1.2;
  }

  .modulos {
    display: flex;
    gap: var(--esp-2);
    max-width: 900px;
    margin: var(--esp-4) auto
      var(--esp-6);
    padding: 0;
    list-style: none;
  }

  .modulos li {
    flex: 1 1 0;
    min-width: 0;
    min-height: 370px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--esp-2);
    border-radius: 10px;
    background: var(--cor-modulo);
    color: #4a3060;
    font-size: clamp(
      1rem,
      1.6vw,
      1.25rem
    );
    font-weight: 800;
    line-height: 1.3;
    text-align: center;
    text-wrap: balance;
    transition:
      flex-grow 400ms ease,
      box-shadow var(--transicao);
  }

  /* O cartão sob o mouse (ou com foco do teclado) cresce
     e empurra os vizinhos, que encolhem juntos. */
  .modulos li:hover,
  .modulos li:focus-visible {
    flex-grow: 2.5;
    box-shadow: 0 12px 28px
      rgba(74, 48, 96, 0.2);
  }

  .modulos li:focus-visible {
    outline: 3px solid var(--roxo);
    outline-offset: 3px;
  }

  @media (max-width: 720px) {
    .modulos {
      flex-direction: column;
      max-width: 420px;
    }

    .modulos li {
      flex: none;
      min-height: 0;
      padding: var(--esp-3) var(--esp-2);
      font-size: 1.1rem;
    }

    .modulos li:hover,
    .modulos li:focus-visible {
      flex-grow: 0;
    }
  }
</style>
