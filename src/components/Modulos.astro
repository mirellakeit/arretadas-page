---
import Faixa from "./Faixa.astro";

const MODULOS = [
  {
    texto:
      "Feminismos e Direitos das Mulheres",
    cor: "#ffc5b3",
  },
  {
    texto:
      "Violência Política de Gênero e raça",
    cor: "var(--roxo-claro)",
  },
  {
    texto:
      "Misoginia Digital Interseccional",
    cor: "#f0dae2",
  },
  {
    texto: "Comunicação feminista",
    cor: "#f4d3bc",
  },
  {
    texto:
      "Autodefesa Digital Feminista",
    cor: "#e6abb2",
  },
];
---

<Faixa
  onda="onda-branca"
  cor="var(--lilas)"
  corOnda="var(--branco)"
  papel
>
  <div class="conteudo">
    <header class="titulo surge">
      <span class="sobre">Sobre o</span>
      <h2>Curso</h2>
      <p class="subtitulo">
        O curso é dividido em 5 módulos
      </p>
    </header>

    <ul class="modulos">
      {
        MODULOS.map((item, i) => (
          <li
            tabindex="0"
            class="surge"
            style={`--cor-modulo: ${item.cor}; --atraso: ${i * 110}ms`}
          >
            {item.texto}
          </li>
        ))
      }
    </ul>
  </div>
</Faixa>

<style>
  .conteudo {
    margin-bottom: -5rem;
  }

  .titulo {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    color: #4a3060;
    margin-top: var(--esp-5);
  }

  .sobre {
    font-size: clamp(
      1.25rem,
      2.2vw,
      1.6rem
    );
    font-weight: 800;
    line-height: 1;
  }

  h2 {
    font-size: clamp(3rem, 7vw, 4.4rem);
    line-height: 1;
    font-weight: 900;
  }

  .subtitulo {
    margin-top: var(--esp-1);
    font-size: clamp(
      1.1rem,
      2vw,
      1.5rem
    );
    font-weight: 800;
    line-height: 1.2;
  }

  .modulos {
    display: flex;
    gap: var(--esp-2);
    max-width: 900px;
    margin: var(--esp-4) auto
      var(--esp-6);
    padding: 0;
    list-style: none;
  }

  .modulos li {
    flex: 1 1 0;
    min-width: 0;
    min-height: 370px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--esp-2);
    border-radius: 10px;
    background: var(--cor-modulo);
    color: #4a3060;
    font-size: clamp(
      1rem,
      1.6vw,
      1.25rem
    );
    font-weight: 800;
    line-height: 1.3;
    text-align: center;
    text-wrap: balance;
    transition:
      flex-grow 400ms ease,
      box-shadow var(--transicao);
  }

  /* O cartão sob o mouse (ou com foco do teclado) cresce
     e empurra os vizinhos, que encolhem juntos. */
  .modulos li:hover,
  .modulos li:focus-visible {
    flex-grow: 2.5;
    box-shadow: 0 12px 28px
      rgba(74, 48, 96, 0.2);
  }

  .modulos li:focus-visible {
    outline: 3px solid var(--roxo);
    outline-offset: 3px;
  }

  @media (max-width: 720px) {
    .modulos {
      flex-direction: column;
      max-width: 420px;
    }

    .modulos li {
      flex: none;
      min-height: 0;
      padding: var(--esp-3) var(--esp-2);
      font-size: 1.1rem;
    }

    .modulos li:hover,
    .modulos li:focus-visible {
      flex-grow: 0;
    }
  }
</style>
