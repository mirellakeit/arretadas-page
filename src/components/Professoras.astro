---
import Faixa from "./Faixa.astro";
import Enfeite from "./Enfeite.astro";
import Svg from "./Svg.astro";

const PROFESSORAS = [
  {
    texto: "Professoras Minibio",
    imagem: "",
  },
  {
    texto: "Professoras Minibio",
    imagem: "",
  },
  {
    texto: "Professoras Minibio",
    imagem: "",
  },
  {
    texto: "Professoras Minibio",
    imagem: "",
  },
];
---

<!-- <Faixa
  onda="onda-creme"
  cor="var(--creme)"
  corOnda="var(--branco)"
  alturaOnda="clamp(50px, 7vw, 110px)"
  id="topo"
  classe="hero"
> -->
<Faixa
  onda="onda-pessego"
  id="professoras"
  cor="var(--pessego)"
  cor-faixa="var(--pessego)"
  corOnda="var(--laranja)"
>
  <div class="conteudo grade">
    <header class="titulo surge">
      <span class="equipe">Equipe</span>
      <h2>Elaboradora</h2>
      <div class="corpo">
        <h3>As</h3>
        <h3 class="mulheres">
          mulheres
        </h3>
        <h3>que fizeram acontecer</h3>
      </div>
    </header>

    <ul class="professoras">
      {
        PROFESSORAS.map((item, i) => (
          <li
            class="surge zoom"
            style={`--atraso: ${i * 120}ms`}
          >
            <Svg
              nome="circulo"
              recolorir={false}
            />
            <p>{item.texto}</p>
          </li>
        ))
      }
    </ul>
  </div>
</Faixa>

<style>
  .grade {
    margin-top: clamp(
      -6rem,
      -10vw,
      -10rem
    );
  }

  .titulo {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: clamp(
      1.5rem,
      5vw,
      6rem
    );
  }

  .equipe {
    font-size: clamp(
      1.1rem,
      1.9vw,
      1.6rem
    );
    font-weight: 800;
    line-height: 1;
    color: var(--roxo);
    margin-bottom: -0.1em;
  }

  h2 {
    font-size: clamp(
      2.4rem,
      5.4vw,
      4.4rem
    );
    font-weight: 900;
    line-height: 1;
    color: var(--roxo-escuro);
  }

  .corpo {
    margin-top: 10px;
    font-size: clamp(
      1rem,
      2.35vw,
      1.8rem
    );
    display: flex;
    gap: 8px;
    color: var(--roxo);
    font-size:;
  }

  .mulheres {
    color: #c24452;
  }

  .professoras {
    display: flex;
    justify-content: center;
    gap: var(--esp-6);
    list-style: none;
  }

  .professoras li {
    flex: 0 0 clamp(140px, 25vw, 200px);
    text-align: center;
  }

  .professoras li svg {
    width: 70%;
    max-width: none;
    height: auto;
  }

  .professoras li p {
    font-size: 1.37rem;
    font-weight: bold;
  }
</style>
