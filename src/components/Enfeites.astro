---
// =========================================================================
// ENFEITES
//
// Desenha uma lista de enfeites de uma vez. As listas de cada seção
// ficam em src/data/enfeites.js (as da Citação, em Citacao.astro).
//
// Uso:  <Enfeites lista={ENFEITES_HERO} />
//
// recortar: true quando a lista fica solta na seção (o padrão), para os
// enfeites serem cortados na borda dela. Listas dentro de uma caixa menor
// (como a ilustração do "Para quem") passam recortar={false}.
// =========================================================================

import Enfeite from "./Enfeite.astro";

const { lista = [], recortar = true } = Astro.props;
---

{lista.map((enfeite: any) => <Enfeite recortar={recortar} {...enfeite} />)}
