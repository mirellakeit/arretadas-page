---
// =========================================================================
// FAIXA
//
// Uma seção de página com fundo chapado e, opcionalmente, uma onda
// escorrendo do topo.
//
// Props:
//   onda        nome do arquivo em src/assets/ondas (sem a extensão)
//   cor         fundo da faixa
//   corOnda     cor da seção anterior, para tapar a fresta do antialias
//   alturaOnda  altura da tira da onda
//   id, classe
//   papel       true carimba a textura de papel dentro da onda. Use quando
//               a seção de cima tem textura (Hero, Sobre o Projeto, Para
//               Quem, FAQ): a onda tem a cor dela e precisa continuar o
//               mesmo papel, senão aparece uma emenda/linha fina.
//               Hoje: Citação (onda do Hero) e Sobre o Curso (onda do
//               Para Quem).
//   forcaPapel  quanto a textura aparece, de 0 a 1
//               (padrão: --opacidade-textura-papel, igual às seções)
//
// A textura das seções não mora aqui: cada seção que tem papel coloca o
// seu <TexturaPapel /> (Hero, SobreProjeto, ParaQuem, Faq).
// =========================================================================

import Svg from "./Svg.astro";
import papelTextura from "../assets/fundos/papel-continuo.webp";

// O mesmo arquivo que o <Svg> injeta inline, agora como URL: a textura é
// recortada no desenho da onda com mask-image, e máscara em CSS só aceita
// URL, nunca um SVG que já está inline no HTML.
const ONDAS_URL = import.meta.glob("../assets/ondas/*.svg", {
  query: "?url",
  import: "default",
  eager: true,
});

const {
  onda = null,
  cor = "var(--branco)",
  // Cor da seção anterior. Pinta apenas os primeiros pixels acima da
  // onda, tapando a fresta clara que o antialias do navegador deixa
  // na emenda entre as duas seções.
  corOnda = "transparent",
  alturaOnda = "clamp(60px, 9vw, 200px)",
  id = null,
  classe = "",
  papel = false,
  forcaPapel = "var(--opacidade-textura-papel)",
} = Astro.props;

const chaveOnda =
  onda && Object.keys(ONDAS_URL).find((k) => k.endsWith(`/${onda}.svg`));

if (onda && papel && !chaveOnda) {
  throw new Error(
    `Faixa: não achei "${onda}.svg" em src/assets/ondas para usar de ` +
      `máscara do papel. Disponíveis: ` +
      Object.keys(ONDAS_URL)
        .map((k) => k.split("/").pop())
        .join(", "),
  );
}

const usaPapel = Boolean(onda && papel && chaveOnda);

// Cor do topo da faixa, embaixo da onda: a da seção de cima (corOnda).
// Sem corOnda, a própria cor da faixa.
const temCorOnda = Boolean(corOnda && corOnda !== "transparent");
const corTopo = temCorOnda ? corOnda : cor;

const estilo = [
  `--cor-faixa:${cor}`,
  `--cor-onda:${corOnda}`,
  `--cor-topo:${corTopo}`,
  // Faixa sem corOnda: a onda é invisível (mesma cor), então o fundo da
  // própria faixa vai até o topo, sem a tira transparente.
  `--topo-livre:${temCorOnda ? "2px" : "0px"}`,
  `--altura-onda:${alturaOnda}`,
  usaPapel ? `--onda-forma:url("${ONDAS_URL[chaveOnda]}")` : null,
  usaPapel ? `--papel:url("${papelTextura.src}")` : null,
  usaPapel ? `--forca-papel:${forcaPapel}` : null,
]
  .filter(Boolean)
  .join("; ");
---

<section class:list={["faixa", classe]} id={id} style={estilo}>
  {
    onda && (
      <div class="onda">
        <Svg nome={onda} ancora="xMidYMax slice" />
        {usaPapel && <span class="papel-onda" />}
      </div>
    )
  }

  <slot />
</section>

<script>
  import "../scripts/alinharPapel.js";
</script>

<style>
  /* EMENDA ENTRE SEÇÕES
     A faixa começa 2px acima do fim da seção de cima (margin-top -2px,
     devolvidos no padding). Nesses 2px, e um pouco abaixo, o fundo é a
     cor da seção de cima (--cor-topo), e a onda (com papel, quando tem)
     passa por cima. Assim o pixel da emenda fica coberto pela mesma cor
     dos dois lados. Antes, em telas com densidade "quebrada" (celulares
     2.625x, 2.75x; Windows em 125%) o navegador misturava esse pixel com
     o fundo da página e aparecia uma linha fina de outra cor. */
  .faixa {
    position: relative; /* referência para a onda e para os enfeites */
    z-index: 2;
    overflow: hidden; /* corta o que escapar e evita rolagem lateral */
    margin-top: -2px;
    /* Nos 2px de cima o fundo é transparente: ali só a onda pinta (ela
       é um grupo só, cor + papel), então a borda dela se mistura com a
       seção de cima sem clarear. Logo abaixo, a cor de cima, por baixo
       da onda; depois, a cor desta faixa. */
    background: linear-gradient(
      to bottom,
      transparent 0 var(--topo-livre, 2px),
      var(--cor-topo) var(--topo-livre, 2px) 6px,
      var(--cor-faixa) 6px
    );
    padding-block: calc(var(--altura-onda) + var(--esp-4) + 2px) var(--esp-5);
  }

  .onda {
    position: absolute;
    /* Começa no topo da caixa, 2px acima do fim da seção de cima (veja a
       emenda acima). Com papel, a textura cobre a emenda inteira. */
    top: 0;
    left: 0;
    right: 0;
    height: var(--altura-onda);
    color: var(--cor-onda);
    background: linear-gradient(
      to bottom,
      var(--cor-onda) 0 3px,
      transparent 3px
    );
    line-height: 0;
    z-index: 1; /* acima dos enfeites, sem cobrir o conteúdo */
  }
  .onda :global(svg) {
    position: relative;
    z-index: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Papel da onda: mesma imagem, tamanho e origem da textura das
     seções (TexturaPapel.astro). O script alinharPapel.js diz a que
     altura da página a onda está (--papel-y), então o papel daqui é a
     continuação exata do papel da seção de cima. A máscara recorta só o
     desenho da onda; o resto continua sendo o fundo desta faixa. */
  .papel-onda {
    position: absolute;
    inset: 0;
    z-index: 1;

    background-image: var(--papel);
    background-size: var(--papel-largura) auto;
    background-repeat: repeat-y;
    background-position: 50% calc(-1 * var(--papel-y, 0px));

    opacity: var(--forca-papel, var(--opacidade-textura-papel));
    mix-blend-mode: multiply;

    -webkit-mask-image: var(--onda-forma);
    mask-image: var(--onda-forma);
    -webkit-mask-size: cover;
    mask-size: cover;
    -webkit-mask-position: center bottom;
    mask-position: center bottom;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }

  @media (max-width: 860px) {
    .faixa {
      padding-block: calc(var(--altura-onda) + var(--esp-3) + 2px) var(--esp-4);
    }
  }
</style>
