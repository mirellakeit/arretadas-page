---
// =========================================================================
// PERGUNTAS FREQUENTES
//
// Última faixa da página: fundo branco com textura de papel e as formas
// bege apagadas de fundos/formas-fundo.svg. As perguntas abrem em
// sanfona e são separadas por uma linha roxa grossa.
//
// Os textos das perguntas ficam em src/data/faq.js.
// =========================================================================

import Faixa from "./Faixa.astro";
import Enfeites from "./Enfeites.astro";
import FundoFormas from "./FundoFormas.astro";
import TexturaPapel from "./TexturaPapel.astro";
import { PERGUNTAS } from "../data/faq.js";
import { ENFEITES_FAQ } from "../data/enfeites.js";

interface Pergunta {
  pergunta: string;
  resposta: string;
}

const perguntas: Pergunta[] = PERGUNTAS;

// Quantas perguntas já começam abertas. O layout mostra todas abertas;
// 1 deixa só a primeira, 0 fecha todas, perguntas.length abre todas.
const ABERTAS = 1;
---

<Faixa onda="onda-pessego-final" corOnda="var(--pessego)" id="faq" classe="faq">
  <FundoFormas opacidade={0.55} />
  <TexturaPapel />
  <Enfeites lista={ENFEITES_FAQ} />

  <div class="conteudo">
    <header class="titulo surge">
      <span class="sobre">Perguntas</span>

      <h2>Frequentes</h2>
    </header>

    <div class="lista">
      {
        perguntas.map((item, i) => (
          <details
            class="item surge"
            style={`--atraso: ${i * 80}ms`}
            open={i < ABERTAS}
          >
            <summary>
              <span class="pergunta">{item.pergunta}</span>
              <svg class="seta" viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M6 9l6 6 6-6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </summary>
            <div class="resposta">
              <p>{item.resposta}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</Faixa>

<style>
  /* No layout a lista é mais larga que o resto da página (87% da tela
     em 1920px), então esta faixa tem a própria largura de conteúdo. */
  .conteudo {
    width: min(100% - 2.5rem, 87vw, 1666px);
    margin-bottom: clamp(2rem, 6vw, 6rem);
    margin-top: -8rem;
  }

  /* --------------------------- título --------------------------- */
  .titulo {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: clamp(3rem, 9vw, 11rem);
    margin-bottom: clamp(1.5rem, 5vw, 6rem);
  }

  .sobre {
    font-size: clamp(1.1rem, 1.9vw, 1.6rem);
    font-weight: 800;
    line-height: 1;
    color: var(--roxo);
    margin-bottom: -0.1em;
  }

  h2 {
    font-size: clamp(2.4rem, 5.4vw, 4.4rem);
    font-weight: 900;
    line-height: 1;
    color: var(--roxo-escuro);
  }

  /* ---------------------------- lista --------------------------- */
  .lista {
    display: grid;
    border-bottom: 2px solid var(--roxo);
  }

  .item {
    border-top: 2px solid var(--roxo);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--esp-2);
    padding: clamp(1.1rem, 2vw, 2rem) clamp(0.5rem, 5vw, 5.5rem)
      clamp(1.1rem, 2vw, 2rem) clamp(0.5rem, 1.2vw, 1.25rem);
    cursor: pointer;
    list-style: none;
    color: var(--roxo-escuro);
    transition: color var(--transicao);
  }

  /* Aberta, a pergunta cola na resposta logo abaixo. */
  .item[open] summary {
    padding-bottom: 0.4rem;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    color: var(--roxo);
  }

  summary:focus-visible {
    outline: 3px solid var(--roxo);
    outline-offset: -3px;
  }

  .pergunta {
    font-size: clamp(1.15rem, 2vw, 1.75rem);
    font-weight: 800;
    line-height: 1.25;
  }

  .seta {
    flex: none;
    width: clamp(20px, 1.8vw, 28px);
    transition: transform var(--transicao);
  }

  /* Seta para cima quando aberta, como no layout. */
  .item[open] .seta {
    transform: rotate(180deg);
  }

  /* O texto alinha com a pergunta e para antes da coluna da seta. */
  .resposta p {
    padding: 0 clamp(0.5rem, 5vw, 5.5rem) clamp(1.25rem, 2.2vw, 2.25rem)
      clamp(0.5rem, 1.2vw, 1.25rem);
    font-size: clamp(1rem, 1.35vw, 1.2rem);
    line-height: 1.5;
    color: var(--cor-texto-neutro);
  }

  /* Abre e fecha deslizando, nos navegadores que já entendem
     ::details-content. Nos outros a sanfona só abre, sem animação. */
  @supports selector(::details-content) {
    .item::details-content {
      block-size: 0;
      overflow: hidden;
      transition:
        block-size var(--transicao),
        content-visibility var(--transicao);
      transition-behavior: allow-discrete;
    }

    .item[open]::details-content {
      block-size: auto;
    }
  }
</style>
