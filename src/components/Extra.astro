---
import Faixa from "./Faixa.astro";
import Enfeite from "./Enfeite.astro";
import Svg from "./Svg.astro";
import { Image } from "astro:assets";
import logoArretadas from "../assets/logo-arretadas.svg";

const CITACAO =
  "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.";

import papel from "../assets/fundos/papel.webp";

// Enfeites tirados de fundos/sobre-projeto.png (layout de 1920px):
// tamanho e topo em vw, esquerda em % da faixa.
const ENFEITES = [
  // Estes três vêm do fim da citação e passam por cima da onda roxa.
  { forma: "asterisco", cor: "#F5F9FA", tamanho: "10.7vw", topo: "-0.5vw", esquerda: "13.1%", giro: -8, frente: true, noCelular: true, tamanhoMobile: "16vw" },
  { forma: "estrela", cor: "#E6E3D2", tamanho: "2.7vw", topo: "2.3vw", esquerda: "37.8%", frente: true },
  { forma: "estrela-arredondada", cor: "#F5F9FA", tamanho: "7.1vw", topo: "1.7vw", esquerda: "72%", giro: 10, frente: true, noCelular: true, tamanhoMobile: "12vw" },

  // Formas roxas penduradas na onda.
  { forma: "trevo", cor: "var(--roxo)", tamanho: "8.3vw", topo: "2.3vw", esquerda: "83.1%", noCelular: true, tamanhoMobile: "14vw" },
  { forma: "estrela-arredondada", cor: "var(--roxo)", tamanho: "6.6vw", topo: "6.1vw", esquerda: "9%", noCelular: true, tamanhoMobile: "12vw" },
  { forma: "asterisco", cor: "var(--roxo)", tamanho: "14.5vw", topo: "10vw", esquerda: "93.3%", giro: 20, noCelular: true, tamanhoMobile: "22vw" },
  { forma: "estrela", cor: "var(--roxo)", opacidade: 0.8, tamanho: "2.25vw", topo: "12.7vw", esquerda: "87.2%" },
  { forma: "estrela", cor: "var(--roxo)", opacidade: 0.8, tamanho: "2.25vw", topo: "15.4vw", esquerda: "4.8%" },
];
---

<!-- <Faixa
  onda="onda-creme"
  cor="var(--roxo)"
  corOnda="var(--creme)"
  id="sobre"
  classe="citacao"
> -->
<Faixa
  onda="onda-roxa"
  cor="var(--branco)"
  corOnda="var(--roxo)"
  id="extra"
  classe="citacao"
>
  <div
    class="textura-papel"
    aria-hidden="true"
    style={`background-image: url("${papel.src}")`}
  >
  </div>

  {ENFEITES.map((e) => <Enfeite {...e} />)}

  <div class="conteudo">
    <h2 class="surge">Sobre o Projeto</h2>
    <div class="grade">
      <div class="midia surge esquerda">
        <div
          class="placeholder"
          role="img"
          aria-label="Espaço reservado para a imagem de abertura"
        >
          <Svg
            nome="video-placeholder"
            recolorir={false}
          />
        </div>
        <!-- Brilho preso no canto de baixo do vídeo, como no layout. -->
        <Enfeite
          forma="estrela"
          cor="var(--roxo)"
          opacidade={0.8}
          tamanho="2.5vw"
          topo="calc(100% - 1.25vw)"
          esquerda="calc(100% - 1.25vw)"
        />
      </div>
      <div class="informacoes surge direita" style="--atraso: 150ms">
        <Image
          src={logoArretadas}
          alt="Logo Arretadas"
        />
        <p>
          {CITACAO}
        </p>
      </div>
    </div>
  </div>
</Faixa>

<style>
  .faixa {
    isolation: isolate;
  }

  .conteudo {
    align-items: center;
  }

  h2 {
    margin-bottom: var(--esp-4);
    text-align: center;
  }

  .grade {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--esp-5);
    align-items: center;
  }

  .fundo-formas {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    line-height: 0;
    opacity: 0.15; /* as formas são textura, não devem competir com o texto */
  }

  .fundo-formas :global(svg) {
    width: 100%;
    height: 100%;
    max-width: none;
    display: block;
  }

  /* Mesma receita do arquivo de design: 15% de opacidade em multiply,
     o suficiente para sujar o creme sem escurecer a leitura. */
  .textura-papel {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-size: cover;
    background-position: center;
    opacity: 0.15;
    mix-blend-mode: multiply;
  }

  .informacoes {
    display: grid;
    gap: var(--esp-3);
  }

  .informacoes :global(img) {
    width: min(100%, 280px);
  }

  .midia {
    position: relative; /* referência para o brilho do canto */
  }

  .placeholder :global(svg) {
    width: 100%;
    height: auto;
    border-radius: var(--raio);
  }

  @media (max-width: 860px) {
    .grade {
      grid-template-columns: 1fr;
      gap: var(--esp-4);
    }
  }
</style>
