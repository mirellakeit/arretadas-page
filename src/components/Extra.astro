---
// =========================================================================
// SOBRE O PROJETO
//
// Faixa branca com a onda roxa escorrendo da citação. Grade 2 x 2:
//
//     título | logo
//     vídeo  | texto
//
// Assim o título fica na altura do logo e o texto começa na altura do
// topo do vídeo. No celular vira uma coluna só.
// =========================================================================

import { Image } from "astro:assets";
import Faixa from "./Faixa.astro";
import Enfeite from "./Enfeite.astro";
import Enfeites from "./Enfeites.astro";
import Svg from "./Svg.astro";
import TexturaPapel from "./TexturaPapel.astro";
import logoArretadas from "../assets/logo-arretadas.svg";
import { ENFEITES_SOBRE_PROJETO, BRILHO_VIDEO } from "../data/enfeites.js";

const TEXTO =
  "O projeto acadêmico “Arretadas em Rede: Livres de Misoginia”, da Universidade Federal do Ceará (UFC) em parceria com a Universidade de Brasília (UnB), fortalece mulheres e redes de proteção para identificar e enfrentar a misoginia digital e a violência política de gênero. Por meio de formação, comunicação e conteúdos educativos acessíveis, produz e difunde conhecimento para tornar o ambiente digital mais seguro, democrático e inclusivo.";
---

<Faixa
  onda="onda-roxa-final"
  cor="var(--branco)"
  corOnda="var(--roxo)"
  id="extra"
>
  <TexturaPapel />
  <Enfeites lista={ENFEITES_SOBRE_PROJETO} />

  <div class="conteudo">
    <div class="grade">
      <h2 class="titulo surge esquerda">
        <span class="titulo-fino">Sobre o</span>
        <span class="titulo-forte">projeto</span>
      </h2>

      <div class="logo surge direita" style="--atraso: 150ms">
        <Image
          src={logoArretadas}
          alt="Logo Arretadas em Rede: Livres de Misoginia"
        />
      </div>

      <div class="midia surge esquerda">
        <div
          class="placeholder"
          role="img"
          aria-label="Espaço reservado para a imagem de abertura"
        >
          <Svg nome="video-placeholder" recolorir={false} />
        </div>
        <Enfeite {...BRILHO_VIDEO} />
      </div>

      <p class="texto surge direita" style="--atraso: 250ms">
        {TEXTO}
      </p>
    </div>
  </div>
</Faixa>

<style>
  /* O global.css puxa a próxima seção 3rem para cima, o que cortava o
     brilho do canto do vídeo. Aqui puxamos menos, sobrando 3rem embaixo.
     Se ainda cortar, aproxime de 0; se sobrar espaço, volte para -2rem. */
  .conteudo {
    margin-bottom: -1rem;
  }

  /* ---------------------------- grade ----------------------------- */
  .grade {
    container-type: inline-size; /* régua para o tamanho do texto */
    display: grid;
    grid-template-columns: 1.2fr 1fr; /* vídeo | texto */
    grid-template-areas:
      "titulo logo"
      "video  texto";
    column-gap: var(--esp-6); /* entre as duas colunas */
    row-gap: var(--esp-4); /* entre o título e o vídeo */
    align-items: start;
  }

  /* --------------------------- título ----------------------------- */
  .titulo {
    grid-area: titulo;
    align-self: end; /* encosta no vídeo */
    display: grid;
    justify-items: center;
    line-height: 0.95;
    color: var(--roxo);
  }

  .titulo-fino {
    font-size: clamp(1.1rem, 2.1vw, 1.8rem);
    font-weight: 800;
  }

  .titulo-forte {
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 900;
    letter-spacing: -0.01em;
  }

  /* ---------------------------- logo ------------------------------ */
  .logo {
    grid-area: logo;
    align-self: center;
    justify-self: center;
  }

  .logo :global(img) {
    display: block;
    width: min(100%, 880px);
    height: auto;
    margin-top: 20px;
    transform: scale(1.33);
    transform-origin: center;
  }

  /* ---------------------------- vídeo ----------------------------- */
  .midia {
    grid-area: video;
    position: relative; /* referência para o brilho do canto */
  }

  .placeholder :global(svg) {
    width: 100%;
    height: auto;
    border-radius: var(--raio);
  }

  /* ---------------------------- texto ----------------------------- */
  /* cqi = 1% da largura da .grade (não da tela). Com 1.95cqi o texto
     ocupa mais ou menos a altura do vídeo em qualquer monitor. */
  .texto {
    grid-area: texto;
    margin: 0;
    font-size: clamp(1rem, 1.95cqi, 1.4rem);
    line-height: 1.35;
    color: var(--roxo-escuro);
  }

  /* ------------------------ telas pequenas ------------------------ */
  @media (max-width: 860px) {
    .grade {
      grid-template-columns: 1fr;
      grid-template-areas:
        "titulo"
        "video"
        "logo"
        "texto";
      row-gap: var(--esp-3);
    }
  }
</style>
