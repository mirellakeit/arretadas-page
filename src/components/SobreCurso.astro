---
// =========================================================================
// SOBRE O CURSO
//
// Faixa lilás com os cinco módulos em sanfona: passando o mouse num
// cartão, ele abre e mostra o texto; os outros viram faixas de cor.
// Abaixo de 1025px os módulos ficam um embaixo do outro, fechados
// (um pedaço da personagem, o título e o começo do texto); tocando
// num cartão, ele se expande e mostra o texto inteiro.
// =========================================================================

import Faixa from "./Faixa.astro";
import Enfeites from "./Enfeites.astro";
import { ENFEITES_SOBRE_CURSO } from "../data/enfeites.js";
import feministas from "../assets/personagens/feministas.svg";
import violencia from "../assets/personagens/violencia.svg";
import misoginia from "../assets/personagens/misoginia.svg";
import comunicacao from "../assets/personagens/comunicacao.svg";
import autodefesa from "../assets/personagens/autodefesa.svg";

// Cada módulo tem a personagem (em src/assets/personagens), a cor do
// cartão e a cor da sombra que escurece a base da ilustração, onde fica
// o nome. As cores ficam em global.css (--modulo-*).
// Troque "descricao" pelo texto real.
const LOREM =
  "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.";

const MOD1 =
  "No módulo 1, vamos resgatar a história do movimento feminista e as conquistas dos direitos das mulheres, como o direito ao voto e marcos legais importantes no Brasil. Também vamos discutir a influência do patriarcado na ocorrência da misoginia e das demais violências contra a mulher, entendendo como essa estrutura histórica ainda se manifesta nos dias de hoje.";
const MOD2 =
  "No módulo 2, vamos conhecer como a violência política de gênero, em uma perspectiva interseccional, utiliza o silenciamento e o preconceito para afastar as mulheres dos espaços de decisão. Além disso, vamos aprender a identificar essas práticas no dia a dia e a acionar os canais eficazes de denúncia disponíveis para enfrentá-las.";
const MOD3 =
  "No módulo 3, vamos entender como a misoginia digital usa algoritmos para espalhar ataques coordenados e desinformação, além de práticas como o racismo algorítmico e o vazamento de fotos. Também vamos estudar leis como a Lei Carolina Dieckmann e a Lei Lola, que são ferramentas essenciais para punir crimes virtuais e nos proteger no ambiente digital.";
const MOD4 =
  "No módulo 4, vamos explorar o poder da comunicação para o feminismo e mostrar como se comunicar de forma eficaz em diferentes meios, adaptando a mensagem a cada contexto e público. Também vamos aprender a detectar a desinformação, reconhecendo os sinais de conteúdos falsos ou manipulados que circulam nas redes e em outros meios de comunicação.";
const MOD5 =
  "Por fim, no módulo 5, vamos estudar como a vida digital exige higiene de dados, senhas fortes e a ativação da verificação em duas etapas nas redes sociais. Navegar com segurança também significa identificar links maliciosos e gerenciar as permissões de aplicativos, evitando o rastreio de metadados e protegendo nossas informações pessoais.";

const MODULOS = [
  {
    titulo: "Feminismos e Direitos das Mulheres",
    descricao: MOD1,
    personagem: feministas,
    cor: "var(--modulo-feministas)",
    sombra: "var(--modulo-feministas-sombra)",
  },
  {
    titulo: "Violência Política de Gênero e Raça",
    descricao: MOD2,
    personagem: violencia,
    cor: "var(--modulo-violencia)",
    sombra: "var(--modulo-violencia-sombra)",
  },
  {
    titulo: "Misoginia Digital Interseccional",
    descricao: MOD3,
    personagem: misoginia,
    cor: "var(--modulo-misoginia)",
    sombra: "var(--modulo-misoginia-sombra)",
  },
  {
    titulo: "Comunicação Feminista",
    descricao: MOD4,
    personagem: comunicacao,
    cor: "var(--modulo-comunicacao)",
    sombra: "var(--modulo-comunicacao-sombra)",
  },
  {
    titulo: "Autodefesa Digital Feminista",
    descricao: MOD5,
    personagem: autodefesa,
    cor: "var(--modulo-autodefesa)",
    sombra: "var(--modulo-autodefesa-sombra)",
  },
];
---

<Faixa
  onda="onda-branca-final"
  id="modulos"
  cor="var(--lilas)"
  corOnda="var(--branco)"
  papel
>
  <Enfeites lista={ENFEITES_SOBRE_CURSO} />

  <div class="conteudo">
    <header class="titulo surge">
      <span class="sobre">Sobre o</span>
      <h2>Curso</h2>
      <p class="subtitulo">O curso é dividido em 5 módulos</p>
    </header>

    <!-- Em repouso os cinco cartões dividem a largura. Passando o mouse
         (ou tocando, ou chegando pelo teclado) num deles, ele abre e
         mostra o texto ao lado da personagem; os outros viram faixas
         de cor. O script no fim do arquivo só troca as classes. -->
    <ul class="modulos" data-modulos>
      {
        MODULOS.map((m, i) => (
          <li
            class="modulo surge"
            tabindex="0"
            style={`--cor-modulo: ${m.cor}; --sombra: ${m.sombra}; --atraso: ${i * 110}ms`}
          >
            <div class="arte">
              <img
                src={m.personagem.src}
                alt=""
                loading="lazy"
                decoding="async"
              />
              <span class="nome" aria-hidden="true">
                {m.titulo}
              </span>
            </div>

            <!-- Seta de abrir/fechar: só aparece nas telas estreitas. -->
            <svg
              class="seta"
              viewBox="0 0 24 16"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="M3 4l9 9 9-9"
                fill="none"
                stroke="currentColor"
                stroke-width="3.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>

            <div class="detalhe">
              <div class="detalhe-texto">
                <h3>{m.titulo}</h3>
                <p>{m.descricao}</p>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</Faixa>

<script>
  // Liga a sanfona de cada lista de módulos. Nas telas largas, os
  // cartões abrem lado a lado (classe "ativo"). Abaixo de 1025px eles
  // ficam um embaixo do outro e cada toque expande ou recolhe o cartão
  // (classe "aberto").
  const larga = matchMedia("(min-width: 1025px)");

  document.querySelectorAll<HTMLElement>("[data-modulos]").forEach((lista) => {
    const itens = [...lista.querySelectorAll<HTMLElement>(".modulo")];
    let ultimoPonteiro = "mouse";

    // ---------- telas estreitas: expandir e recolher ----------
    // A altura aberta é medida no texto e passada ao CSS, para a
    // transição de altura funcionar.
    const medir = (item: HTMLElement) => {
      const texto = item.querySelector<HTMLElement>(".detalhe-texto");
      if (texto) item.style.setProperty("--aberto", `${texto.offsetHeight}px`);
    };

    const marcar = (item: HTMLElement, aberto: boolean) => {
      item.classList.toggle("aberto", aberto);
      if (larga.matches) item.removeAttribute("aria-expanded");
      else item.setAttribute("aria-expanded", String(aberto));
    };

    const alternar = (item: HTMLElement) => {
      const abrir = !item.classList.contains("aberto");
      if (abrir) medir(item);
      marcar(item, abrir);
    };

    const recolherTodos = () => itens.forEach((item) => marcar(item, false));
    recolherTodos();

    // Girando o celular, o texto muda de altura: mede de novo.
    addEventListener("resize", () => {
      if (larga.matches) return;
      itens.filter((i) => i.classList.contains("aberto")).forEach(medir);
    });

    const ativar = (alvo: HTMLElement | null) => {
      for (const item of itens) {
        item.classList.toggle("ativo", item === alvo);
      }
      lista.classList.toggle("tem-ativo", Boolean(alvo));
    };

    lista.addEventListener("pointerdown", (e) => {
      ultimoPonteiro = e.pointerType;
    });

    for (const item of itens) {
      // Mouse: abre ao passar por cima.
      item.addEventListener("pointerenter", (e) => {
        if (e.pointerType === "mouse" && larga.matches) ativar(item);
      });

      // Toque: abre no primeiro toque, fecha no segundo.
      // Telas estreitas: cada toque expande ou recolhe o cartão.
      item.addEventListener("click", () => {
        if (!larga.matches) return alternar(item);
        if (ultimoPonteiro === "mouse") return;
        ativar(item.classList.contains("ativo") ? null : item);
      });

      // Telas estreitas pelo teclado: Enter ou espaço.
      item.addEventListener("keydown", (e) => {
        if (larga.matches || (e.key !== "Enter" && e.key !== " ")) return;
        e.preventDefault();
        alternar(item);
      });

      // Teclado: o cartão com foco fica aberto.
      item.addEventListener("focus", () => {
        if (larga.matches) ativar(item);
      });
    }

    // Saindo da lista, volta todo mundo ao repouso.
    lista.addEventListener("pointerleave", (e) => {
      if (e.pointerType === "mouse") ativar(null);
    });

    lista.addEventListener("focusout", (e) => {
      if (!lista.contains(e.relatedTarget as Node)) ativar(null);
    });

    larga.addEventListener("change", () => {
      ativar(null);
      recolherTodos();
    });
  });
</script>

<style>
  .conteudo {
    /* Os cartões ocupam 68% da tela: um pouco menos que no layout
       (80%), para a seção caber inteira na tela. */
    width: min(100% - 2.5rem, 68vw, 1300px);
    margin-bottom: -5rem;
  }

  /* --------------------------- título --------------------------- */
  .titulo {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-top: var(--esp-5);
  }

  .sobre {
    font-size: clamp(1.25rem, 2.2vw, 2.4rem);
    font-weight: 800;
    line-height: 1;
    color: var(--roxo);
  }

  h2 {
    font-size: clamp(3rem, 7vw, 6rem);
    line-height: 0.95;
    font-weight: 900;
    color: var(--roxo-profundo);
  }

  .subtitulo {
    margin-top: var(--esp-2);
    font-size: clamp(1.1rem, 2.3vw, 2.6rem);
    font-weight: 800;
    line-height: 1.2;
    color: var(--roxo);
  }

  /* --------------------------- módulos -------------------------- */
  /* Medidas do layout em 1920px: cartão de 286 x 745 e faixa fechada
     com metade da largura do cartão. Tudo sai da largura da lista
     (cqw), então a proporção se mantém em qualquer tela larga. */
  .modulos {
    container-type: inline-size;
    --vao: clamp(10px, 1.1vw, 22px);
    --cartao: calc((100cqw - 4 * var(--vao)) / 5);
    --faixa: calc(var(--cartao) * 0.5);
    --detalhe: calc(100cqw - var(--cartao) - 4 * (var(--faixa) + var(--vao)));

    display: flex;
    gap: var(--vao);
    margin: clamp(2rem, 4vw, 5rem) 0 var(--esp-6);
    padding: 0;
    list-style: none;
  }

  :global(.js) .titulo.surge.visivel,
  :global(.js) .modulo.surge.visivel {
    animation-duration: 1200ms;
    animation-timing-function: cubic-bezier(0.42, 0, 0.58, 1);
  }

  .modulo {
    flex: 1 1 0;
    min-width: 0;
    /* No layout o cartão tem 2,6 vezes a largura na altura. Aqui fica
       em 2,4 e nunca passa de 72% da altura da tela. */
    height: min(calc(var(--cartao) * 2.4), 72vh);
    display: flex;
    border-radius: var(--raio);
    overflow: hidden;
    background: var(--cor-modulo);
    cursor: pointer;
    transition:
      flex-grow 850ms cubic-bezier(0.42, 0, 0.58, 1),
      flex-basis 850ms cubic-bezier(0.42, 0, 0.58, 1),
      background-color 500ms ease-in-out;

  }

  .modulo:focus-visible {
    outline: 3px solid var(--roxo);
    outline-offset: 3px;
  }

  /* Um aberto: os outros viram faixas, ele ocupa o resto. */
  .modulos.tem-ativo .modulo {
    flex: 0 0 var(--faixa);
  }

  .modulos.tem-ativo .modulo.ativo {
    flex: 1 1 0;
    background: var(--branco);
    cursor: default;
  }

  /* ----------------------------- arte --------------------------- */
  .arte {
    position: relative;
    flex: none;
    width: var(--cartao);
    height: 100%;
    background: var(--cor-modulo);
    overflow: hidden;
  }

  .arte img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  /* Sombra na base, para o nome em branco ficar legível. */
  .arte::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 55%,
      color-mix(in srgb, var(--sombra) 70%, transparent) 80%,
      var(--sombra) 100%
    );
    pointer-events: none;
  }

  .nome {
    position: absolute;
    z-index: 1;
    left: 0;
    right: 0;
    bottom: clamp(0.6rem, 1.2vw, 1.5rem);
    padding-inline: 0.5rem;
    color: var(--branco);
    font-size: clamp(0.9rem, 1.25vw, 1.6rem);
    font-weight: 800;
    line-height: 1.05;
    text-align: center;
    text-wrap: balance;
  }

  /* Faixas fechadas: só a cor, sem personagem. */
  .arte img,
  .arte::after,
  .nome {
    transition: opacity 1300ms ease-in-out;
  }

  .modulos.tem-ativo .modulo:not(.ativo) .arte img,
  .modulos.tem-ativo .modulo:not(.ativo) .arte::after,
  .modulos.tem-ativo .modulo:not(.ativo) .nome {
    opacity: 0;
  }

  /* --------------------------- detalhe -------------------------- */
  /* O texto tem largura fixa (a do cartão aberto) e fica escondido
     atrás do overflow enquanto o cartão cresce. Assim ele não fica
     se reorganizando durante a animação: só aparece. */
  .detalhe {
    flex: 1 1 0;
    min-width: 0;
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  .detalhe-texto {
    flex: none;
    width: var(--detalhe);
    padding: var(--esp-3) clamp(1rem, 2vw, 2.5rem);
    opacity: 0;
    transition: opacity 500ms ease-in-out;
  }

  .modulo.ativo .detalhe-texto {
    opacity: 1;
    transition-delay: 220ms;
  }

  h3 {
    font-size: clamp(1.3rem, 1.8vw, 2.2rem);
    font-weight: 800;
    line-height: 1;
    text-wrap: wrap; /* o balance global quebraria em três linhas */
    color: var(--coral-escuro);
    margin-bottom: clamp(0.75rem, 1.6vw, 1.75rem);
  }

  .detalhe p {
    font-size: clamp(0.95rem, 1.05vw, 1.25rem);
    line-height: 1.4;
    color: var(--cor-texto-neutro);
  }

  /* A seta de abrir/fechar só existe nas telas estreitas. */
  .seta {
    display: none;
  }

  /* ------------------ telas médias e pequenas ------------------- */
  /* Cinco cartões lado a lado não cabem: os módulos ficam um embaixo
     do outro. Fechados, mostram um pedaço da personagem, o título e o
     começo do texto, que some num degradê. Um toque expande o cartão
     e mostra o texto inteiro; outro toque recolhe.
     Sem JavaScript, os cartões aparecem abertos (sem seta e sem
     degradê), para o texto nunca ficar escondido. */
  @media (max-width: 1024px) {
    .conteudo {
      width: min(100% - 2.5rem, 760px);
    }

    .modulos {
      container-type: normal;
      flex-direction: column;
      gap: var(--esp-2);
    }

    .modulo,
    .modulos.tem-ativo .modulo {
      /* Altura do cartão fechado. */
      --fechado: clamp(11.5rem, 48vw, 15rem);
      /* Quanto a personagem é ampliada dentro da coluna da imagem. */
      --zoom-arte: 1.55;

      position: relative;
      flex: none;
      height: auto;
      min-height: var(--fechado);
      background: var(--branco);
      cursor: default;
    }

    :global(.js) .modulo,
    :global(.js) .modulos.tem-ativo .modulo {
      height: var(--fechado);
      min-height: 0;
      cursor: pointer;
      transition: height 600ms cubic-bezier(0.42, 0, 0.58, 1);
    }

    :global(.js) .modulo.aberto {
      height: max(var(--fechado), var(--aberto, var(--fechado)));
    }

    /* Coluna da personagem: só um pedaço dela, ampliado. */
    .arte,
    .modulo.ativo .arte {
      width: min(32%, 13rem);
      height: auto;
      align-self: stretch;
    }

    /* A imagem segue a largura da coluna (e não a altura do cartão),
       para o recorte não mudar quando o cartão se expande. */
    .arte img {
      position: absolute;
      inset: 0 0 auto 0;
      height: auto;
      transform: scale(var(--zoom-arte));
      transform-origin: 25% 0;
    }

    /* O nome sobre a imagem sai: o título já está ao lado. */
    .arte::after,
    .nome {
      display: none;
    }

    .modulos.tem-ativo .modulo:not(.ativo) .arte img {
      opacity: 1;
    }

    /* Degradê na base do cartão fechado, sobre a imagem e o texto. */
    :global(.js) .modulo::after {
      content: "";
      position: absolute;
      inset: auto 0 0 0;
      height: 50%;
      background: linear-gradient(
        to bottom,
        transparent 0%,
        color-mix(in srgb, var(--sombra) 12%, transparent) 40%,
        color-mix(in srgb, var(--sombra) 55%, transparent) 75%,
        var(--sombra) 100%
      );
      pointer-events: none;
      transition: opacity 450ms ease-in-out;
    }

    :global(.js) .modulo.aberto::after {
      opacity: 0;
    }

    :global(.js) .seta {
      display: block;
      position: absolute;
      z-index: 1;
      top: clamp(0.85rem, 3vw, 1.25rem);
      right: clamp(0.9rem, 3.5vw, 1.4rem);
      width: clamp(1.4rem, 5vw, 1.8rem);
      height: auto;
      color: var(--coral-escuro);
      transition: transform 450ms ease-in-out;
    }

    :global(.js) .modulo.aberto .seta {
      transform: rotate(180deg);
    }

    /* O texto começa no alto (e não centralizado), para o cartão
       fechado mostrar o título e as primeiras linhas. */
    .detalhe {
      align-items: flex-start;
    }

    .detalhe-texto {
      width: 100%;
      flex: 1 1 auto;
      opacity: 1;
      padding: clamp(2.6rem, 9vw, 3.5rem) clamp(1rem, 4vw, 1.75rem)
        var(--esp-3) clamp(0.9rem, 3.5vw, 1.5rem);
    }

    h3 {
      font-size: clamp(1.25rem, 4.8vw, 1.75rem);
      margin-bottom: clamp(0.6rem, 2.4vw, 1rem);
    }

    .detalhe p {
      font-size: clamp(0.95rem, 3.6vw, 1.1rem);
    }
  }

  @media (max-width: 1024px) and (prefers-reduced-motion: reduce) {
    :global(.js) .modulo,
    :global(.js) .modulo::after,
    :global(.js) .seta {
      transition: none;
    }
  }
</style>
