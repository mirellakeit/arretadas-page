---
// =========================================================================
// HERO
//
// Primeira dobra da página, logo abaixo do cabeçalho fixo.
// Duas colunas: ilustração à esquerda, título e chamada à direita.
//
// Não usa <Faixa> porque aqui não existe onda no topo: a onda creme que
// separa o hero da seção seguinte mora no topo da <Citacao>.
// =========================================================================

import Svg from "./Svg.astro";
import Enfeites from "./Enfeites.astro";
import FundoFormas from "./FundoFormas.astro";
import TexturaPapel from "./TexturaPapel.astro";
import { ENFEITES_HERO } from "../data/enfeites.js";

// const imagensHero = ["imagem-hero1", "imagem-hero2", "hero"];
const imagensHero = ["imagem-hero3", "imagem-hero2", "imagem-hero1"];

const CHAMADA1 =
  "Um curso de aperfeiçoamento gratuito e a distância sobre mobilização de redes, enfrentamento à violência política de gênero e ocupação dos espaços de decisão.";
const CHAMADA2 =
  "O curso Fortalecendo Mulheres - Direitos, Defesa Digital e Participação Política une história, liderança e proteção online. Em 5 módulos, você dominará direitos fundamentais, combate à violência política de gênero e enfrentamento à misoginia digital, além de estratégias de comunicação e práticas essenciais de cibersegurança. Vamos ocupar as redes com poder e segurança!";
---

<section class="hero" id="topo">
  <FundoFormas cobrir />
  <TexturaPapel porCima />
  <Enfeites lista={ENFEITES_HERO} />

  <div class="conteudo grade">
    <div class="ilustracao surge esquerda">
      {
        imagensHero.map((nome, index) => (
          <div class:list={["hero-image", { active: index === 0 }]}>
            <Svg nome={nome} recolorir={false} />
          </div>
        ))
      }
    </div>

    <div class="texto surge direita" style="--atraso: 150ms">
      <h1>
        <span class="titulo-fino">Fortalecendo</span>
        <span class="titulo-forte">Mulheres</span>
        <span class="subtitulo">
          Direitos, defesa digital e participação política
        </span>
      </h1>

      <p class="chamada chamada-desktop">{CHAMADA2}</p>
      <p class="chamada chamada-mobile">{CHAMADA1}</p>

      <button type="button" id="btn-my-toggle" aria-pressed="false"
        >mudar imagem</button
      >
    </div>
  </div>
</section>

<script>
  const imagens = document.querySelectorAll("#topo .ilustracao .hero-image");
  let indice = 0;

  document.querySelector("#btn-my-toggle")?.addEventListener("click", () => {
    if (imagens.length === 0) return;

    imagens[indice].classList.remove("active");
    indice = (indice + 1) % imagens.length;
    imagens[indice].classList.add("active");
  });
</script>
<style>
  .hero-image {
    display: none;
  }

  .hero-image.active {
    display: block;
  }

  .hero {
    position: relative; /* referência para o fundo decorativo */
    z-index: 1;
    overflow: hidden; /* corta a ilustração que sangra para a esquerda */
    background: var(--creme);
    padding-top: 1rem;
    margin-bottom: -1rem;
  }

  /* -------------------------- estrutura ------------------------- */
  .grade {
    display: grid;
    grid-template-columns:
      minmax(0, 0.62fr)
      minmax(0, 1fr);
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2.5rem);
  }

  button {
    background-color: #f6f0c5;
    color: #f6f0c5;
    border: 0;
  }

  button:hover {
    color: var(--roxo);
    border: 0;
  }

  /* A ilustração passa da margem do container e encosta na borda da
     tela, como no layout. O overflow da seção corta o que sobrar. */
  .ilustracao {
    /* Nunca sangra mais do que a margem lateral do container: assim a
       ilustração encosta na borda da tela sem nunca ser cortada. */
    --sangria: max(
      0px,
      min(11vw, 13rem, calc((100vw - var(--largura-conteudo)) / 2))
    );

    justify-self: start;
    width: calc(100% + var(--sangria));
    margin-inline-start: calc(-1 * var(--sangria));
  }

  .ilustracao :global(svg) {
    display: block;
    width: 100%;
    max-width: none;
    height: auto;
  }

  /* -------------------------- tipografia ------------------------ */
  /* Todo o bloco de título é derivado de uma medida só: mexer em --t
     redimensiona "Fortalecendo", "Mulheres" e o subtítulo juntos. */
  .texto {
    margin-top: 6.5rem;
    --t: clamp(2rem, 8.6vw, 8rem);

    /* Contorno creme em volta das letras do título. */
    --contorno:
      3px 3px 0 var(--creme), -1px -1px 0 var(--creme), 1px -1px 0 var(--creme),
      -1px 1px 0 var(--creme), 1px 1px 0 var(--creme);
  }

  h1 {
    display: grid;
    line-height: 0.95;
    margin: 0;
  }

  .titulo-fino {
    font-size: calc(var(--t) * 0.47);
    font-weight: 800;
    color: var(--coral);
    text-shadow: var(--contorno);
  }

  .titulo-forte {
    font-size: var(--t);
    font-weight: 800;
    letter-spacing: -0.015em;
    color: var(--roxo);
    text-shadow: var(--contorno);
  }

  .subtitulo {
    margin-top: 0.45rem;
    font-size: max(1.05rem, calc(var(--t) * 0.195));
    font-weight: 700;
    line-height: 1.2;
    color: var(--coral);
  }

  .chamada-desktop {
    font-size: 1.2rem;
    margin-top: clamp(0.8rem, 2vw, 1.6rem);
    max-width: 58ch; /* 50 a 75 caracteres é a faixa confortável de leitura */
  }

  .chamada-mobile {
    display: none;
  }

  /* ------------------------- telas pequenas --------------------- */
  @media (max-width: 900px) {
    .conteudo {
      margin-bottom: 1.25rem;
    }

    .grade {
      grid-template-columns: 1fr;
      gap: var(--esp-3);
    }

    .ilustracao {
      --sangria: 0rem;
      justify-self: center;
      width: min(100%, 420px);
    }

    .texto {
      margin-top: -2rem;
      text-align: center;
      --t: clamp(2.5rem, 13vw, 5rem);
    }

    .subtitulo {
      margin: auto;
      max-width: 28ch;
    }

    .chamada-mobile {
      display: block;
      margin-top: 1.25rem;
      text-align: left;
    }

    .chamada-desktop {
      display: none;
    }
  }
</style>
