---
// =========================================================================
// HERO
//
// Primeira dobra da página, logo abaixo do cabeçalho fixo.
// Duas colunas: ilustração à esquerda, título e chamada à direita.
//
// Não usa <Faixa> porque aqui não existe onda no topo: a onda creme que
// separa o hero da seção seguinte mora no topo da <Citacao>.
// =========================================================================

import Svg from "./Svg.astro";

// A textura de papel entra como imagem de fundo, não como <Svg> inline:
// o paper.svg original é só um PNG de 4 MB embrulhado em SVG, e inline
// ele iria parar dentro do HTML. Aqui vira um .webp de ~50 kB.
import papel from "../assets/fundos/papel.webp";
---

<section class="hero" id="topo">
  <!-- Formas claras do design, bem apagadas, dando textura ao creme. -->
  <div
    class="fundo-formas"
    aria-hidden="true"
  >
    <Svg
      nome="formas-fundo"
      recolorir={false}
      ancora="xMidYMid slice"
    />
  </div>

  <!-- Papel amassado por cima do creme e das formas, em multiply. -->
  <div
    class="textura-papel"
    aria-hidden="true"
    style={`background-image: url("${papel.src}")`}
  >
  </div>

  <div class="conteudo grade">
    <div class="ilustracao surge esquerda">
      <Svg
        nome="hero"
        recolorir={false}
      />
    </div>

    <div class="texto surge direita" style="--atraso: 150ms">
      <h1>
        <span class="titulo-fino"
          >Fortalecendo</span
        >
        <span class="titulo-forte"
          >Mulheres</span
        >
        <span class="subtitulo">
          Direitos, defesa digital e
          participação política
        </span>
      </h1>

      <p class="chamada">
        Um curso de aperfeiçoamento
        gratuito e a distância sobre
        mobilização de redes,
        enfrentamento à violência
        política de gênero e ocupação
        dos espaços de decisão.
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative; /* referência para o fundo decorativo */
    z-index: 1;
    overflow: hidden; /* corta a ilustração que sangra para a esquerda */
    background: var(--creme);
    padding-top: 1rem;
    margin-bottom: -1rem;
  }

  /* --------------------------- fundo --------------------------- */
  .fundo-formas {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    line-height: 0;
    opacity: 0.15; /* as formas são textura, não devem competir com o texto */
  }

  .fundo-formas :global(svg) {
    width: 100%;
    height: 100%;
    max-width: none;
    display: block;
  }

  /* Mesma receita do arquivo de design: 15% de opacidade em multiply,
     o suficiente para sujar o creme sem escurecer a leitura. */
  .textura-papel {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background-size: cover;
    background-position: center;
    opacity: 0.15;
    mix-blend-mode: multiply;
  }

  /* -------------------------- estrutura ------------------------- */
  .grade {
    display: grid;
    grid-template-columns:
      minmax(0, 0.62fr)
      minmax(0, 1fr);
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2.5rem);
  }

  /* A ilustração passa da margem do container e encosta na borda da
     tela, como no layout. O overflow da seção corta o que sobrar. */
  .ilustracao {
    /* Nunca sangra mais do que a margem lateral do container: assim a
       ilustração encosta na borda da tela sem nunca ser cortada. */
    --sangria: max(
      0px,
      min(
        11vw,
        13rem,
        calc(
          (
              100vw -
                var(--largura-conteudo)
            ) /
            2
        )
      )
    );

    justify-self: start;
    width: calc(100% + var(--sangria));
    margin-inline-start: calc(
      -1 * var(--sangria)
    );
  }

  .ilustracao :global(svg) {
    display: block;
    width: 100%;
    max-width: none;
    height: auto;
  }

  /* -------------------------- tipografia ------------------------ */
  /* Todo o bloco de título é derivado de uma medida só: mexer em --t
     redimensiona "Fortalecendo", "Mulheres" e o subtítulo juntos. */
  .texto {
    --t: clamp(2.75rem, 8.6vw, 8rem);
  }

  h1 {
    display: grid;
    line-height: 0.95;
    margin: 0;
  }

  .titulo-fino {
    font-size: calc(var(--t) * 0.47);
    font-weight: 800;
    color: var(--coral);

    text-shadow:
      3px 3px 0 var(--creme),
      -1px -1px 0 var(--creme),
      1px -1px 0 var(--creme),
      -1px 1px 0 var(--creme),
      1px 1px 0 var(--creme);
  }

  .titulo-forte {
    font-size: var(--t);
    font-weight: 800;
    letter-spacing: -0.015em;
    color: var(--roxo);
    text-shadow:
      3px 3px 0 var(--creme),
      -1px -1px 0 var(--creme),
      1px -1px 0 var(--creme),
      -1px 1px 0 var(--creme),
      1px 1px 0 var(--creme);
  }

  .subtitulo {
    margin-top: 0.45rem;
    font-size: max(
      1.05rem,
      calc(var(--t) * 0.195)
    );
    font-weight: 700;
    line-height: 1.2;
    color: var(--coral);
  }

  .chamada {
    font-size: 1.2rem;
    margin-top: clamp(
      0.5rem,
      2.2vw,
      1.2rem
    );
    max-width: 58ch; /* 50 a 75 caracteres é a faixa confortável de leitura */
  }

  /* ------------------------- telas pequenas --------------------- */
  @media (max-width: 900px) {
    .grade {
      grid-template-columns: 1fr;
      gap: var(--esp-3);
    }

    .ilustracao {
      --sangria: 0rem;

      justify-self: center;
      width: min(100%, 420px);
    }

    .texto {
      --t: clamp(2.5rem, 13vw, 5rem);
    }
  }
</style>
