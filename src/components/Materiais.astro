---
// =========================================================================
// MATERIAIS ADICIONAIS
//
// Faixa pêssego logo depois do "Sobre o Curso", com a onda lilás
// escorrendo do topo. À esquerda o título e a capa da cartilha (que é
// o link de download); à direita a chamada.
// =========================================================================

import Faixa from "./Faixa.astro";
import Enfeite from "./Enfeite.astro";

// Troque pelo endereço real do PDF da cartilha.
const LINK_CARTILHA = "#";

// Enfeites copiados do layout (1920px): tamanho e topo em vw, esquerda
// em % da faixa. As formas apagadas do fundo usam um pêssego mais
// escuro em opacidade baixa.
const APAGADA = "#FDD9B5";
const LILAS_FORTE = "#BFA9CD";

const ENFEITES = [
  // Grandes e apagadas, no fundo.
  {
    forma: "estrela-cinco-lados",
    cor: APAGADA,
    opacidade: 0.5,
    tamanho: "30.7vw",
    topo: "7vw",
    esquerda: "7.7%",
    giro: -15,
  },
  {
    forma: "estrela",
    cor: APAGADA,
    opacidade: 0.5,
    tamanho: "8.8vw",
    topo: "21.8vw",
    esquerda: "54.2%",
  },
  {
    forma: "trevo-cinco-lados",
    cor: APAGADA,
    opacidade: 0.5,
    tamanho: "17.5vw",
    topo: "7.6vw",
    esquerda: "82.2%",
  },
  {
    forma: "asterisco",
    cor: APAGADA,
    opacidade: 0.5,
    tamanho: "36vw",
    baixo: "0.5vw",
    esquerda: "44%",
    giro: 10,
  },

  // Penduradas na onda lilás.
  {
    forma: "estrela-arredondada",
    cor: "var(--lilas)",
    tamanho: "19vw",
    topo: "-4.8vw",
    esquerda: "75.6%",
    giro: 6,
    noCelular: true,
    tamanhoMobile: "26vw",
  },
  {
    forma: "asterisco",
    cor: "var(--pessego)",
    tamanho: "12vw",
    topo: "0.4vw",
    esquerda: "23%",
    frente: true,
  },
  {
    forma: "estrela-arredondada",
    cor: "#EF847C",
    tamanho: "7.1vw",
    topo: "7.6vw",
    esquerda: "87.1%",
    giro: 14,
    frente: true,
    noCelular: true,
    tamanhoMobile: "11vw",
  },

  // Destaques.
  {
    forma: "estrela",
    cor: LILAS_FORTE,
    opacidade: 0.6,
    tamanho: "3.8vw",
    topo: "11.4vw",
    esquerda: "2.7%",
  },
  {
    forma: "trevo-cinco-lados",
    cor: "#EF8279",
    tamanho: "6.9vw",
    topo: "14.5vw",
    esquerda: "7.1%",
    noCelular: true,
    tamanhoMobile: "11vw",
  },
  {
    forma: "asterisco",
    cor: "#E85453",
    tamanho: "18.4vw",
    topo: "22.9vw",
    esquerda: "-3.1%",
    giro: -6,
    noCelular: true,
    tamanhoMobile: "24vw",
    esquerdaMobile: "-10%",
  },
  {
    forma: "trevo-cinco-lados",
    cor: LILAS_FORTE,
    tamanho: "9.3vw",
    topo: "14.7vw",
    esquerda: "59%",
  },
  {
    forma: "estrela-cinco-lados",
    cor: "#ED726C",
    tamanho: "4.6vw",
    topo: "24.3vw",
    esquerda: "67.7%",
    giro: 10,
  },
  {
    forma: "estrela",
    cor: LILAS_FORTE,
    opacidade: 0.6,
    tamanho: "3.8vw",
    topo: "13.4vw",
    esquerda: "80.2%",
  },
  {
    forma: "asterisco",
    cor: "var(--lilas)",
    tamanho: "18.4vw",
    topo: "13.6vw",
    esquerda: "90.4%",
    giro: 18,
    noCelular: true,
    tamanhoMobile: "24vw",
  },
];
---

<Faixa
  onda="onda-lilas"
  id="materiais"
  cor="var(--pessego)"
  corOnda="var(--lilas)"
>
  {
    ENFEITES.map((e) => (
      <Enfeite {...e} />
    ))
  }

  <div class="conteudo grade">
    <header class="titulo surge">
      <span class="sobre"
        >Materiais</span
      >
      <h2>Adicionais</h2>
    </header>

    <a
      class="capa surge esquerda"
      href={LINK_CARTILHA}
      download
      aria-label="Baixar a Cartilha de Prevenção e Proteção nas Redes"
    >
      <!-- Troque pela capa da cartilha:
           <Image src={capa} alt="" /> -->
    </a>

    <div
      class="chamada surge direita"
      style="--atraso: 150ms"
    >
      <h3>
        Cartilha de Prevenção
        <span class="linha"
          >e Proteção nas Redes</span
        >
      </h3>
      <p>
        Clique na imagem ao lado para
        baixar a Cartilha de Prevenção e
        Proteção nas Redes!
      </p>
    </div>
  </div>
</Faixa>

<style>
  .grade {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      minmax(0, 1fr);
    grid-template-areas:
      "titulo ."
      "capa   chamada";
    column-gap: var(--esp-5);
    row-gap: var(--esp-3);
    align-items: center;
    margin-top: clamp(1rem, 5vw, 5rem);
    margin-bottom: 0;
  }

  /* --------------------------- título --------------------------- */
  .titulo {
    grid-area: titulo;
    display: flex;
    flex-direction: column;
    align-items: center;
    color: var(--coral-escuro);
  }

  .sobre {
    font-size: clamp(
      1.1rem,
      1.9vw,
      1.5rem
    );
    font-weight: 800;
    line-height: 1;
    margin-bottom: -0.1em;
  }

  h2 {
    font-size: clamp(
      2.6rem,
      6vw,
      4.4rem
    );
    line-height: 1;
    font-weight: 900;
  }

  /* ---------------------------- capa ---------------------------- */
  .capa {
    grid-area: capa;
    justify-self: center;
    display: block;
    width: min(100%, 27rem);
    aspect-ratio: 275 / 255;
    border-radius: 10px;
    background: #f0dae2;
    overflow: hidden;
    transition:
      transform var(--transicao),
      box-shadow var(--transicao);
  }

  .capa :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .capa:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 30px
      rgba(194, 68, 82, 0.2);
  }

  .capa:focus-visible {
    outline: 3px solid
      var(--coral-escuro);
    outline-offset: 4px;
  }

  /* --------------------------- chamada -------------------------- */
  .chamada {
    grid-area: chamada;
    display: grid;
    gap: var(--esp-2);
    max-width: 30rem;
    margin-inline-start: clamp(
      0rem,
      4vw,
      4rem
    );
  }

  h3 {
    font-size: clamp(
      1.4rem,
      2.3vw,
      2.1rem
    );
    font-weight: 800;
    line-height: 1.1;
    color: var(--coral-escuro);
  }

  /* Segunda linha do título, como no layout. No celular volta a correr
     junto com o resto. */
  .linha {
    display: block;
  }

  .chamada p {
    font-size: clamp(
      1.05rem,
      1.5vw,
      1.3rem
    );
    line-height: 1.45;
    color: #222;
  }

  /* ------------------------ telas pequenas ---------------------- */
  @media (max-width: 860px) {
    .grade {
      grid-template-columns: 1fr;
      grid-template-areas:
        "titulo"
        "capa"
        "chamada";
      justify-items: center;
      text-align: center;
    }

    .chamada {
      margin-inline-start: 0;
    }

    .capa {
      width: min(100%, 22rem);
    }

    .linha {
      display: inline;
    }
  }
</style>
