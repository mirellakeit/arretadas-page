---
// =========================================================================
// MATERIAIS ADICIONAIS
//
// Faixa pêssego logo depois do "Sobre o Curso", com a onda lilás
// escorrendo do topo. Três materiais em zigue-zague: a capa (que é o
// link de download) alterna de lado a cada item, e a chamada fica do
// outro lado. Nos itens pares o texto se alinha à direita, colado na
// capa, como no layout.
// =========================================================================

import Faixa from "./Faixa.astro";
import Enfeite from "./Enfeite.astro";
import Enfeites from "./Enfeites.astro";
import { ENFEITES_MATERIAIS, estrelinhaCapa } from "../data/enfeites.js";

import CAPA_RADIO from "../assets/materiais-adicionais/radio-debate.jpeg";

// Troque "link" pelo endereço real de cada PDF e, quando houver, "capa"
// por uma imagem importada de src/assets (ex.: import capaCartilha
// from "../assets/capas/cartilha.png").
const MATERIAIS = [
  {
    titulo: ["Cartilha de Prevenção", "e Proteção nas Redes"],
    texto:
      "Clique na imagem ao lado para baixar a Cartilha de Prevenção e Proteção nas Redes!",
    link: "#",
    capa: null,
  },
  {
    titulo: ["Episódio de Podcast"],
    texto: 'Misoginia Digital e o Projeto \"Arretadas em Rede!\"',
    link: "https://open.spotify.com/episode/6ZJShGzowqhAYpNLIRcqRY",
    capa: CAPA_RADIO,
  },
];
---

<Faixa
  onda="onda-lilas-final"
  corOnda="var(--lilas)"
  id="materiaisadicionais"
  cor="var(--pessego)"
>
  <Enfeites lista={ENFEITES_MATERIAIS} />

  <div class="conteudo">
    <header class="titulo surge">
      <span class="sobre">Materiais</span>
      <h2>Adicionais</h2>
    </header>

    <ul class="materiais">
      {
        MATERIAIS.map((m, i) => {
          const invertido = i % 2 === 1;
          return (
            <li class:list={["item", { invertido }]}>
              <div
                class:list={[
                  "moldura",
                  "surge",
                  invertido ? "direita" : "esquerda",
                ]}
              >
                <a
                  target="_blank"
                  rel="noopener noreferrer"
                  class="capa"
                  href={m.link}
                  aria-label={`Baixar: ${m.titulo.join(" ")}`}
                >
                  {m.capa && <img src={m.capa.src} alt="" loading="lazy" />}
                </a>
                <Enfeite {...estrelinhaCapa(invertido)} />
              </div>

              <div
                class:list={[
                  "chamada",
                  "surge",
                  invertido ? "esquerda" : "direita",
                ]}
                style="--atraso: 150ms"
              >
                <h3>
                  {m.titulo.map((linha) => (
                    <span class="linha">{linha}</span>
                  ))}
                </h3>
                <p>{m.texto}</p>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</Faixa>

<script>
  document
    .querySelectorAll<HTMLAnchorElement>(".materiais a.capa[target='_blank']")
    .forEach((link) => {
      link.addEventListener("click", (event) => {
        if (
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        ) {
          return;
        }

        if (new URL(link.href).origin === window.location.origin) return;

        event.preventDefault();
        window.open(link.href, "_blank", "noopener,noreferrer");
      });
    });
</script>

<style>
  /* Duas colunas iguais com um vão largo no meio. A coluna da esquerda
     encosta o conteúdo no vão (justify-self: end) e a da direita
     também (start): assim a capa de um item e o texto do seguinte
     ficam alinhados pela mesma borda, como no layout. */
  .conteudo {
    --vao: clamp(2rem, 9vw, 12rem);
    --largura-capa: min(100%, 28rem);
    margin-top: clamp(1rem, 4vw, 4rem);
    margin-bottom: 0;
  }

  .titulo,
  .item {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      minmax(0, 1fr);
    column-gap: var(--vao);
  }

  /* --------------------------- título --------------------------- */
  .titulo {
    color: var(--coral-escuro);
    margin-bottom: clamp(1rem, 2.5vw, 2.5rem);
  }

  /* O título fica centrado sobre a primeira capa. */
  .titulo > * {
    grid-column: 1;
    justify-self: end;
    width: var(--largura-capa);
    text-align: center;
  }

  .sobre {
    font-size: clamp(1.1rem, 1.9vw, 1.5rem);
    font-weight: 800;
    line-height: 1;
    margin-bottom: -0.1em;
  }

  h2 {
    font-size: clamp(2.6rem, 6vw, 4.4rem);
    line-height: 1;
    font-weight: 900;
  }

  /* --------------------------- itens ---------------------------- */
  .materiais {
    list-style: none;
    padding: 0;
    display: grid;
    gap: clamp(1.5rem, 3vw, 3rem);
  }

  .item {
    align-items: center;
  }

  .moldura {
    position: relative; /* referência para a estrelinha do canto */
    grid-column: 1;
    grid-row: 1;
    justify-self: end;
    width: var(--largura-capa);
  }

  .chamada {
    grid-column: 2;
    grid-row: 1;
    justify-self: start;
    display: grid;
    gap: var(--esp-2);
    max-width: 30rem;
  }

  /* Itens pares: capa à direita, texto à esquerda alinhado à direita. */
  .invertido .moldura {
    grid-column: 2;
    justify-self: start;
  }

  .invertido .chamada {
    grid-column: 1;
    justify-self: end;
    text-align: right;
  }

  /* ---------------------------- capa ---------------------------- */
  .capa {
    display: block;
    width: 100%;
    aspect-ratio: 275 / 255;
    border-radius: 10px;
    background: var(--rosa-palido);
    overflow: hidden;
    transition:
      transform var(--transicao),
      box-shadow var(--transicao);
  }

  .capa img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .capa:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 30px
      color-mix(in srgb, var(--coral-escuro) 20%, transparent);
  }

  .capa:focus-visible {
    outline: 3px solid var(--coral-escuro);
    outline-offset: 4px;
  }

  /* --------------------------- chamada -------------------------- */
  h3 {
    font-size: clamp(1.4rem, 2.3vw, 2.1rem);
    font-weight: 800;
    line-height: 1.1;
    color: var(--coral-escuro);
  }

  /* Cada pedaço do título numa linha, como no layout. No celular volta
     a correr junto com o resto. */
  .linha {
    display: block;
  }

  .chamada p {
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
    line-height: 1.45;
    color: var(--cor-texto-neutro);
  }

  /* ------------------------ telas pequenas ---------------------- */
  @media (max-width: 860px) {
    .titulo,
    .item {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }

    .titulo > *,
    .moldura,
    .invertido .moldura {
      grid-column: 1;
      grid-row: auto;
      justify-self: center;
    }

    .moldura {
      width: min(100%, 22rem);
    }

    .chamada,
    .invertido .chamada {
      grid-column: 1;
      grid-row: auto;
      justify-self: center;
      text-align: center;
      margin-top: var(--esp-3);
    }

    .materiais {
      gap: var(--esp-5);
    }

    .linha {
      display: inline;
    }

    .linha + .linha::before {
      content: " ";
    }
  }
</style>
