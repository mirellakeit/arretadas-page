---
// =========================================================================
// CABEÇALHO FIXO
// Fica colado no topo enquanto a página rola. Os links levam às seções
// da própria página usando âncoras (#id), sem recarregar nada.
// =========================================================================

import { Image } from "astro:assets";
import logoArretadas from "../assets/logo-arretadas.svg";

// Os itens do menu vivem em um array. Para acrescentar uma seção,
// basta adicionar uma linha aqui, sem mexer no HTML.
const LINKS = [
  {
    texto: "Sobre o projeto",
    destino: "#extra",
  },
  {
    texto: "Sobre o Curso",
    destino: "#modulos",
  },
  {
    texto: "Materiais Adicionais",
    destino: "#materiaisadicionais",
  },
  {
    texto: "Professoras",
    destino: "#professoras",
  },
  { texto: "FAQ", destino: "#faq" },
];

// Link externo do formulário de inscrição. Troque pelo endereço real.
const LINK_INSCRICAO = "https://forms.gle/exemplo";
---

<header class="cabecalho">
  <div class="conteudo barra">
    <a href="#topo" aria-label="Voltar ao início">
      <Image src={logoArretadas} alt="Logo Arretadas" />
    </a>

    <nav class="menu" aria-label="Navegação Principal">
      {LINKS.map((link) => <a href={link.destino}>{link.texto}</a>)}
    </nav>

    <a
      class="botao"
      href={LINK_INSCRICAO}
      target="_blank"
      rel="noopener noreferrer"
    >
      Inscreva-se já!
    </a>
  </div>
</header>

<style>
  .cabecalho {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--creme);
  }

  .barra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--esp-3);
    padding-block: 0.75rem;
  }

  .menu {
    display: flex;
    gap: var(--esp-3);
  }

  .menu a {
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    padding-block: 0.25rem;
    border-bottom: 2px solid transparent;
    transition:
      border-color var(--transicao),
      color var(--transicao);
  }

  .menu a:hover {
    color: var(--coral);
    border-bottom-color: var(--coral);
  }

  @media (max-width: 900px) {
    .menu {
      display: none;
    }
  }
</style>
