---
// =========================================================================
// ENFEITE
//
// Posiciona uma das formas decorativas flutuando no fundo de uma faixa.
// A forma em si vem do arquivo exportado do design, via <Svg>.
//
// Props:
//   forma     nome do arquivo em src/assets/formas (sem a extensão)
//   cor       cor do enfeite (a forma foi convertida para currentColor)
//   tamanho   largura. Número vira px; texto passa direto ("8vw",
//             "clamp(...)"), útil para acompanhar a largura da tela
//   topo, baixo, esquerda, direita   posição dentro da faixa, em % ou px.
//             Com baixo e sem topo, a forma se ancora pela base da faixa
//   frente    true coloca a forma acima da onda da faixa (mas ainda atrás
//             do conteúdo). Serve para formas que passam por cima da onda
//   giro      rotação em graus
//   opacidade
//   noCelular manter visível abaixo de 720px
//   papel      true carimba a textura de papel dentro da forma
//   forcaPapel quanto a textura aparece, de 0 a 1 (padrão 0.3). Acima de
//              0.45 o creme começa a amarelar.
// =========================================================================

import Svg from "./Svg.astro";
import papelTextura from "../assets/fundos/papel.webp";

// Os mesmos arquivos que o <Svg> injeta inline, agora como URL. A textura
// é recortada na forma com mask-image, e máscara em CSS só aceita URL:
// não dá para apontar para um SVG que já está inline no HTML.
const FORMAS_URL = import.meta.glob(
  "../assets/formas/*.svg",
  {
    query: "?url",
    import: "default",
    eager: true,
  },
);

const {
  forma = "estrela",
  cor = "var(--roxo-claro)",
  tamanho = 48,
  topo = null,
  baixo = null,
  esquerda = null,
  direita = null,
  giro = 0,
  opacidade = 1,
  noCelular = false,
  tamanhoMobile = null,
  topoMobile = null,
  esquerdaMobile = null,
  direitaMobile = null,
  papel = false,
  forcaPapel = 0.3,
  frente = false,
} = Astro.props;

// Número é px, texto vai como veio (vw, clamp, calc...).
const medida = (v) =>
  typeof v === "number" ? `${v}px` : v;

const chaveForma = Object.keys(
  FORMAS_URL,
).find((k) =>
  k.endsWith(`/${forma}.svg`),
);

if (papel && !chaveForma) {
  throw new Error(
    `Enfeite: não achei "${forma}.svg" em src/assets/formas para usar de ` +
      `máscara do papel. Disponíveis: ` +
      Object.keys(FORMAS_URL)
        .map((k) => k.split("/").pop())
        .join(", "),
  );
}

// Cada enfeite mostra um pedaço diferente da folha de papel. Sem isso
// todos repetiriam o mesmo amassado e a repetição fica evidente.
// O sorteio é determinístico: mesma posição, mesmo recorte em todo build.
const semente = `${forma}${topo}${baixo}${esquerda}${direita}${tamanho}`;
let h = 0;
for (const c of semente) {
  h =
    (h * 31 + c.charCodeAt(0)) % 100000;
}
const recorte = `${h % 100}% ${Math.floor(h / 100) % 100}%`;

const estilo = [
  `--topo:${topo ?? (baixo ? "auto" : "10%")}`,
  baixo ? `--baixo:${baixo}` : null,
  esquerda
    ? `--esquerda:${esquerda}`
    : null,
  direita
    ? `--direita:${direita}`
    : null,
  `--tamanho:${medida(tamanho)}`,
  topoMobile
    ? `--topo-mobile:${topoMobile}`
    : null,
  esquerdaMobile
    ? `--esquerda-mobile:${esquerdaMobile}`
    : null,
  direitaMobile
    ? `--direita-mobile:${direitaMobile}`
    : null,
  tamanhoMobile
    ? `--tamanho-mobile:${medida(tamanhoMobile)}`
    : null,
  `color:${cor}`,
  `opacity:${opacidade}`,
  `transform:rotate(${giro}deg)`,
  papel
    ? `--forma:url("${FORMAS_URL[chaveForma!]}")`
    : null,
  papel
    ? `--papel:url("${papelTextura.src}")`
    : null,
  papel
    ? `--forca-papel:${forcaPapel}`
    : null,
  papel
    ? `--recorte-papel:${recorte}`
    : null,
  // Atraso sorteado com a mesma semente, para os enfeites de uma
  // mesma faixa não brotarem todos no mesmo instante.
  `--atraso:${(h % 5) * 90}ms`,
]
  .filter(Boolean)
  .join(";");
---

<span
  class:list={[
    "enfeite",
    "brota",
    { "no-celular": noCelular, frente },
  ]}
  style={estilo}
>
  <Svg nome={forma} />
  {papel && <span class="papel" />}
</span>

<style>
  .enfeite {
    position: absolute; /* sai do fluxo e flutua nas coordenadas dadas */
    top: var(--topo);
    bottom: var(--baixo, auto);
    left: var(--esquerda, auto);
    right: var(--direita, auto);
    width: var(--tamanho);
    pointer-events: none; /* não intercepta cliques de botões e links */
    z-index: 0; /* atrás da onda e do conteúdo da faixa */
    line-height: 0;
  }

  /* Mesma camada da onda, mas vem depois dela no HTML: pinta por cima
     da onda e continua atrás do .conteudo (z-index 2). */
  .enfeite.frente {
    z-index: 1;
  }

  .enfeite :global(svg) {
    position: relative;
    z-index: 0;
    display: block;
    width: 100%;
    height: auto;
  }

  /* A textura cobre a caixa inteira e a máscara deixa aparecer só o que
     cai dentro da forma. O multiply mistura com a cor do enfeite, que
     está pintada logo abaixo; o z-index e o transform do .enfeite já
     criam um contexto próprio, então a mistura não vaza para a página.

     --escala-papel é o tamanho da folha: quanto menor, maior o amassado
     dentro da forma. 600px deixa um enfeite de ~130px mostrando um quinto
     da folha, que é onde os vincos ficam legíveis. */
  .papel {
    position: absolute;
    inset: 0;
    z-index: 1;

    background-image: var(--papel);
    background-size: var(
        --escala-papel,
        600px
      )
      auto;
    background-position: var(
      --recorte-papel,
      center
    );

    opacity: var(--forca-papel, 0.3);
    mix-blend-mode: multiply;

    -webkit-mask-image: var(--forma);
    mask-image: var(--forma);
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }

  @media (max-width: 720px) {
    .enfeite:not(.no-celular) {
      display: none;
    }

    .enfeite.no-celular {
      top: var(
        --topo-mobile,
        var(--topo)
      );
      left: var(
        --esquerda-mobile,
        var(--esquerda, auto)
      );
      right: var(
        --direita-mobile,
        var(--direita, auto)
      );
      width: var(
        --tamanho-mobile,
        var(--tamanho)
      );
    }
  }
</style>
