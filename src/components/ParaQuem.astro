---
// =========================================================================
// QUEM JÁ FEZ O CURSO
//
// Ilustração do computador à esquerda, sobre formas lilases, e a lista
// de quem já fez o curso à direita.
//
// As formas são enfeites como nas outras seções (ENFEITES_PARA_QUEM em
// src/data/enfeites.js), mas medidos em % da caixa da ilustração e não
// da seção: assim crescem e encolhem junto com o computador.
// =========================================================================

import Faixa from "./Faixa.astro";
import Enfeites from "./Enfeites.astro";
import Svg from "./Svg.astro";
import TexturaPapel from "./TexturaPapel.astro";
import { ENFEITES_PARA_QUEM } from "../data/enfeites.js";

const CONTEMPLADAS = ["Assessoras", "Líderes", "Empresárias", "Universitárias"];
---

<Faixa
  onda="onda-branca-final"
  cor="var(--branco)"
  corOnda="var(--branco)"
  alturaOnda="clamp(60px, 9vw, 140px)"
>
  <TexturaPapel porCima />

  <div class="conteudo grade">
    <div class="midia surge esquerda">
      <Enfeites lista={ENFEITES_PARA_QUEM} />

      <div
        class="computador"
        role="img"
        aria-label="Punhos erguidos segurando bandeiras com o símbolo feminino saindo de um notebook"
      >
        <Svg nome="computador" recolorir={false} />
      </div>
    </div>

    <div class="coluna">
      <h2 class="titulo surge direita">
        <span class="titulo-fino">Quem já fez o</span>
        <span class="titulo-forte">curso?</span>
      </h2>

      <ul class="contempladas">
        {CONTEMPLADAS.map((item, i) => (
          <li class="surge direita" style={`--atraso: ${150 + i * 100}ms`}>
            {item}
          </li>
        ))}
      </ul>
    </div>
  </div>
</Faixa>

<style>
  .grade {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: var(--esp-4);
    align-items: center;
  }

  /* --------------------- ilustração + formas ----------------------
     A caixa tem a proporção do layout original (970 x 786). As formas
     e o computador são posicionados em % dela. */
  .midia {
    position: relative;
    width: min(100%, 640px);
    aspect-ratio: 970 / 786;
    justify-self: start;
  }

  .computador {
    position: absolute;
    z-index: 1; /* na frente das formas */
    left: 18%;
    top: 4.5%;
    width: 71%;
  }

  .computador :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ---------------------------- texto ----------------------------- */
  .coluna {
    justify-self: center;
    display: grid;
    gap: var(--esp-3);
  }

  .titulo {
    display: grid;
    justify-items: center;
    line-height: 0.95;
    color: var(--rosa);
  }

  .titulo-fino {
    font-size: clamp(1.1rem, 2.1vw, 1.8rem);
    font-weight: 800;
  }

  .titulo-forte {
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 900;
    letter-spacing: -0.01em;
  }

  .contempladas {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.9em;
    font-size: clamp(1.05rem, 1.6vw, 1.45rem);
    color: var(--roxo);
  }

  li {
    display: flex;
    align-items: center;
    gap: 0.8em;
    font-weight: 700;
    line-height: 1.2;
  }

  /* Quadradinho roxo antes de cada item. */
  li::before {
    content: "";
    flex: 0 0 1.25em;
    width: 1.25em;
    height: 1.25em;
    border-radius: 0.4em;
    background: var(--roxo);
  }

  /* ------------------------ telas pequenas ------------------------ */
  @media (max-width: 860px) {
    .grade {
      grid-template-columns: 1fr;
      gap: var(--esp-3);
      /* A margem negativa do .conteudo (global.css) é maior que o
         respiro da faixa no celular e cortava a última linha. */
      margin-bottom: 0;
    }

    .midia {
      width: min(100%, 460px);
      justify-self: center;
    }
  }
</style>
