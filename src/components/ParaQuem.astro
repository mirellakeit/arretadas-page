---
// =========================================================================
// QUEM JÁ FEZ O CURSO
//
// Ilustração do computador à esquerda, sobre formas lilases, e o público
// do curso descrito em texto à direita.
//
// As formas são enfeites como nas outras seções (ENFEITES_PARA_QUEM em
// src/data/enfeites.js), mas medidos em % da caixa da ilustração e não
// da seção: assim crescem e encolhem junto com o computador.
// =========================================================================

import Faixa from "./Faixa.astro";
import Enfeites from "./Enfeites.astro";
import Svg from "./Svg.astro";
import TexturaPapel from "./TexturaPapel.astro";
import { ENFEITES_PARA_QUEM } from "../data/enfeites.js";

const TEXTO =
  "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.";
---

<Faixa
  onda="onda-branca-final"
  cor="var(--branco)"
  corOnda="var(--branco)"
  alturaOnda="clamp(60px, 9vw, 140px)"
>
  <TexturaPapel porCima />

  <div class="conteudo grade">
    <div class="midia surge esquerda">
      <Enfeites lista={ENFEITES_PARA_QUEM} />

      <div
        class="computador"
        role="img"
        aria-label="Punhos erguidos segurando bandeiras com o símbolo feminino saindo de um notebook"
      >
        <Svg nome="computador" recolorir={false} />
      </div>
    </div>

    <div class="coluna">
      <div class="linha">
        <h2 class="titulo surge direita">
          <span class="titulo-fino">Para quem é o</span>
          <span class="titulo-forte">curso?</span>
        </h2>
        <Svg nome="para_quem" recolorir={false} />
      </div>

      <p class="texto surge direita" style="--atraso: 150ms">{TEXTO}</p>
    </div>
  </div>
</Faixa>

<style>
  .grade {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: var(--esp-4);
    align-items: center;
  }

  /* --------------------- ilustração + formas ----------------------
     A caixa tem a proporção do layout original (970 x 786). As formas
     e o computador são posicionados em % dela. */
  .midia {
    position: relative;
    width: min(100%, 640px);
    aspect-ratio: 970 / 786;
    justify-self: start;
  }

  .computador {
    position: absolute;
    z-index: 1; /* na frente das formas */
    left: 18%;
    top: 4.5%;
    width: 71%;
  }

  .computador :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ---------------------------- texto ----------------------------- */
  .coluna {
    justify-self: center;
    display: grid;
    gap: var(--esp-1);
  }

  .linha {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .titulo {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 0.8;
    color: var(--rosa);
  }

  .titulo-fino {
    font-size: clamp(1.2rem, 1.9vw, 1.6rem);
    font-weight: 800;
  }

  .titulo-forte {
    font-size: clamp(2.2rem, 4.7vw, 3.9rem);
    font-weight: 900;
    letter-spacing: -0.01em;
  }

  .texto {
    margin: 0;
    font-size: clamp(0.95rem, 1.3vw, 1.15rem);
    line-height: 1.45;
    color: var(--roxo-escuro);
  }

  .linha > :global(svg) {
    width: clamp(6rem, 15vw, 10rem);
    height: auto;
    flex: 0 0 auto;
  }

  /* ------------------------ telas pequenas ------------------------ */
  @media (max-width: 860px) {
    .grade {
      margin-top: -4rem;
      grid-template-columns: 1fr;
      grid-template-areas:
        "coluna"
        "midia";
      row-gap: var(--esp-4);
      /* A margem negativa do .conteudo (global.css) é maior que o
         respiro da faixa no celular e cortava a última linha. */
      margin-bottom: 0;
    }

    .coluna {
      grid-area: coluna;
      width: 100%;
      gap: var(--esp-2);
    }

    .linha {
      gap: 0.25rem;
    }

    .titulo-fino {
      font-size: clamp(1rem, 4.5vw, 1.15rem);
    }

    .titulo-forte {
      font-size: clamp(1.7rem, 8vw, 1.9rem);
    }

    .linha > :global(svg) {
      width: clamp(3rem, 14vw, 3.5rem);
    }

    .texto {
      font-size: clamp(0.875rem, 4vw, 0.95rem);
      line-height: 1.6;
    }

    .midia {
      grid-area: midia;
      width: min(100%, 300px);
      justify-self: center;
    }
  }
</style>
